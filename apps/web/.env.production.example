# PLACEHOLDERS ONLY: no domain has been chosen yet. Set these in the hosting provider's environment settings (Netlify, Vercel, ...),
# never in a committed file. They are read at BUILD time (NEXT_PUBLIC_*), so changing one means a new build.
# Read docs/frontend/DEPLOYMENT.md first: it explains the two ways to reach the API and which one fits custom school domains.

# The platform's domain. Must equal the API's BASE_DOMAIN.
NEXT_PUBLIC_BASE_DOMAIN=example.com

# Must equal the API's ADMIN_SUBDOMAIN (default "admin").
NEXT_PUBLIC_ADMIN_SUBDOMAIN=admin

# How the browser reaches the API. Pick ONE:
#   Same origin (recommended; works for custom school domains): the web host forwards /api/* to the API, keeping the original host.
NEXT_PUBLIC_API_URL=/api/v1
#   Separate API host (only if the API can tell the school from the browser's Origin; see DEPLOYMENT.md "Option B"):
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
