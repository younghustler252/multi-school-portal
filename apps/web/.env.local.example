# Copy this file to `.env.local` (git-ignored) and adjust. Restart `npm run dev:web` after any change:
# NEXT_PUBLIC_* values are read when Next.js starts and are visible in the browser. Never put secrets here.

# Where the browser sends API requests: host and port only, no protocol and no path.
# Must match the API's PORT (apps/api/.env.development, default 5000). The API must be started with
# BASE_DOMAIN=localhost so it accepts school subdomains (apps/api/.env.development.example).
#
# The school's subdomain is carried over automatically, because the API chooses the school from the Host header:
#   http://localhost:3000             -> http://localhost:5000/api/v1            platform / public
#   http://greenfield.localhost:3000  -> http://greenfield.localhost:5000/api/v1  school "greenfield"
#
# Production hosts and custom domains are decided in Phase 2 (API-003 / TENANT-001); do not rely on this for them yet.
NEXT_PUBLIC_API_HOST=localhost:5000
