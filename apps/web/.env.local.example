# Local development. Copy to .env.local (ignored by git). Every value below is the default, so a plain checkout works without this file.
# The full list of variables and the production settings are in docs/frontend/DEPLOYMENT.md.

# Where apps/api listens (development derives the per-school API host from this: greenfield.localhost:3000 -> greenfield.localhost:5000).
NEXT_PUBLIC_API_HOST=localhost:5000

# Same as the API's BASE_DOMAIN. "localhost" makes links http://<school>.localhost:3000.
NEXT_PUBLIC_BASE_DOMAIN=localhost

# Leave these unset in development:
# NEXT_PUBLIC_API_URL=          (set this in production)
# NEXT_PUBLIC_ADMIN_SUBDOMAIN=admin
# NEXT_PUBLIC_PUBLIC_SUBDOMAINS=www
# NEXT_PUBLIC_WEB_PORT=3000
