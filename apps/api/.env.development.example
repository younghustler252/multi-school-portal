# Copy to .env.development (and .env.production on the server). Never commit the real file.
NODE_ENV=development
PORT=5000
BASE_DOMAIN=localhost
ADMIN_SUBDOMAIN=admin
COOKIE_DOMAIN=
PUBLIC_URL_PORT=3000

DATABASE_URL=postgresql://postgres:password@localhost:5432/school_portal

# 32+ characters each. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
SUPABASE_PUBLIC_BUCKET=

# Email: SMTP or Brevo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

TERMII_API_KEY=
TERMII_SENDER_ID=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Salary transfers spend the balance behind the secret key. Keep false until decided.
PAYSTACK_TRANSFERS_ENABLED=false

REDIS_HOST=localhost
REDIS_PORT=6379

SENTRY_DSN=
