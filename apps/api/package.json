{
  "name": "@schoolos/api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "tsx --import ./tests/setup/env.ts --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev:worker": "nodemon --exec ts-node src/worker.ts",
    "start:worker": "node dist/worker.js",
    "db:backup": "ts-node scripts/backup-database.ts",
    "db:restore": "ts-node scripts/restore-database.ts",
    "sync:registries": "tsx src/foundation/sync-registries.ts",
    "prisma:generate:public": "prisma generate --config=prisma.public.config.ts",
    "prisma:generate:tenant": "prisma generate --config=prisma.tenant.config.ts",
    "prisma:generate": "npm run prisma:generate:public && npm run prisma:generate:tenant",
    "prisma:migrate:public": "prisma migrate dev --config=prisma.public.config.ts",
    "prisma:migrate:tenant": "prisma migrate dev --config=prisma.tenant.config.ts",
    "prisma:migrate:deploy:public": "prisma migrate deploy --config=prisma.public.config.ts",
    "prisma:migrate:deploy:tenant": "prisma migrate deploy --config=prisma.tenant.config.ts",
    "migrate:apply-to-existing-schools": "ts-node scripts/apply-migration-to-existing-schools.ts",
    "sync:school-roles": "ts-node scripts/sync-school-roles.ts",
    "sync:school-roles:dry-run": "ts-node scripts/sync-school-roles.ts --dry-run",
    "migrate:apply-to-existing-schools:dry-run": "ts-node scripts/apply-migration-to-existing-schools.ts --dry-run"
  },
  "keywords": [],
  "author": "Young Tech",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@bull-board/api": "^8.3.0",
    "@bull-board/express": "^8.3.0",
    "@bull-board/ui": "^8.3.0",
    "@getbrevo/brevo": "^5.0.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.74.0",
    "@supabase/supabase-js": "^2.108.2",
    "awilix": "^13.0.5",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.4",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.22.0",
    "puppeteer": "^25.8.0",
    "slugify": "^1.6.6",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.11",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "prisma@7.8.0": true
  },
  "overrides": {
    "@hono/node-server": "^1.19.13"
  }
}
