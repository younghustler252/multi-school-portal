generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/tenant"
}

datasource db {
  provider = "postgresql"
}

// ===== SHARED AUTHORIZATION ENUMS =====

enum Persona {
  STAFF
  STUDENT
  GUARDIAN
}

enum PermissionScope {
  ALL
  BRANCH
  ASSIGNED
  OWN
}

enum RoleKind {
  SYSTEM_LOCKED
  SYSTEM_EDITABLE
  CUSTOM
}

enum MembershipStatus {
  active
  suspended
  removed
}

enum StaffCategory {
  teaching
  non_teaching
}

enum EmploymentType {
  full_time
  part_time
  contract
  volunteer
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum DeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

// ===== PEOPLE =====

model Staff {
  id             String         @id @default(uuid())
  userId         String?        @unique
  employeeId     String?        @unique
  firstName      String
  lastName       String
  middleName     String?
  email          String?
  phone          String?
  photoUrl       String?
  gender         Gender?
  dateOfBirth    DateTime?
  address        String?
  department     String?
  designation    String?
  qualification  String?
  category       StaffCategory  @default(non_teaching)
  employmentType EmploymentType @default(full_time)
  joinDate       DateTime?
  exitDate       DateTime?
  exitReason     String?
  role           StaffRole      @default(other)
  isActive       Boolean        @default(true)
  createdById    String?
  updatedById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  classSubjects         ClassSubject[]
  classesAsClassTeacher Class[]
  subjectDefaults       Subject[]      @relation("SubjectDefaultTeacher")
  branches              StaffBranch[]

  @@index([isActive])
  @@index([category])
  @@index([email])
  @@index([deletedAt])
}

enum StaffRole {
  school_admin
  principal
  teacher
  bursar
  other
}

enum Gender {
  male
  female
}

model Student {
  id              String    @id @default(uuid())
  userId          String?   @unique
  admissionNumber String?   @unique
  firstName       String
  lastName        String
  middleName      String?
  dateOfBirth     DateTime?
  gender          Gender?
  bloodGroup      String?
  address         String?
  photoUrl        String?
  religion        String?
  nationality     String?   @default("Nigerian")
  stateOfOrigin   String?
  isActive        Boolean   @default(true)
  graduatedAt     DateTime?
  graduatedTermId String?
  admittedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enrolments    Enrolment[]
  guardianLinks StudentGuardian[]
  attendances   Attendance[]
  grades        Grade[]
  feeInvoices   FeeInvoice[]
  reportCards   ReportCard[]
  discounts     StudentDiscount[]
  allocations   PaymentAllocation[]
  refunds       Refund[]

  @@index([graduatedAt])
}

model Guardian {
  id         String   @id @default(uuid())
  userId     String?  @unique
  firstName  String
  lastName   String
  email      String
  phone      String?
  occupation String?
  address    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  studentLinks StudentGuardian[]
  payments     Payment[]
}

model StudentGuardian {
  id         String           @id @default(uuid())
  studentId  String
  guardianId String
  relation   GuardianRelation
  isPrimary  Boolean          @default(false)
  createdAt  DateTime         @default(now())

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
}

enum GuardianRelation {
  father
  mother
  uncle
  aunt
  grandparent
  sibling
  guardian
  other
}

// ===== ACADEMIC =====

model CalendarEvent {
  id          String    @id @default(uuid())
  termId      String?
  sessionId   String?
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  type        EventType @default(event)
  isHoliday   Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  term    Term?    @relation(fields: [termId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([startDate])
  @@index([termId])
}

enum EventType {
  holiday
  event
  exam
  break
  other
}

model Session {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms            Term[]
  calendarEvents   CalendarEvent[]
  journalEntries   JournalEntry[]
  feeStructures    FeeStructure[]
  feeInvoices      FeeInvoice[]
  studentDiscounts StudentDiscount[]
}

model Term {
  id        String   @id @default(uuid())
  sessionId String
  name      TermName
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session        Session         @relation(fields: [sessionId], references: [id])
  classSubjects  ClassSubject[]
  attendances    Attendance[]
  calendarEvents CalendarEvent[]
  grades         Grade[]
  feeInvoices    FeeInvoice[]
  enrolments     Enrolment[]
  reportCards    ReportCard[]
  journalEntries JournalEntry[]
  feeStructures  FeeStructure[]
}

enum TermName {
  first
  second
  third
}

model Class {
  id             String   @id @default(uuid())
  name           String
  level          String?
  capacity       Int?
  classTeacherId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classTeacher     Staff?             @relation(fields: [classTeacherId], references: [id])
  enrolments       Enrolment[]
  classSubjects    ClassSubject[]
  progressionsFrom ClassProgression[] @relation("ProgressionFrom")
  progressionsTo   ClassProgression[] @relation("ProgressionTo")
  feeStructures    FeeStructure[]
  feeInvoices      FeeInvoice[]
  attendance       Attendance[]
}

model Subject {
  id               String   @id @default(uuid())
  name             String
  code             String?  @unique
  description      String?
  defaultTeacherId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  defaultTeacher Staff?         @relation("SubjectDefaultTeacher", fields: [defaultTeacherId], references: [id])
  classSubjects  ClassSubject[]
}

model ClassSubject {
  id          String                       @id @default(uuid())
  classId     String
  subjectId   String
  staffId     String
  termId      String
  assignedVia ClassSubjectAssignmentSource @default(manual)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])
  grades  Grade[]

  @@unique([classId, subjectId, termId])
}

enum ClassSubjectAssignmentSource {
  manual
  auto_subject_default
  auto_homeroom
}

model Enrolment {
  id        String          @id @default(uuid())
  studentId String
  classId   String
  termId    String
  status    EnrolmentStatus @default(active)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
}

enum EnrolmentStatus {
  active
  withdrawn
  transferred
  completed
}

model ClassProgression {
  id          String   @id @default(uuid())
  fromClassId String   @unique
  toClassId   String?
  fromClass   Class    @relation("ProgressionFrom", fields: [fromClassId], references: [id])
  toClass     Class?   @relation("ProgressionTo", fields: [toClassId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TeachingModel {
  homeroom
  subject_specialist
}

// ===== SCHOOL SETTINGS =====

model SchoolSettings {
  id                        String         @id @default(uuid())
  logoUrl                   String?
  primaryColor              String?        @default("#1a1a2e")
  secondaryColor            String?
  motto                     String?
  address                   String?
  website                   String?
  foundedYear               Int?
  principalName             String?
  stamp                     String?
  reportCardTemplate        String         @default("classic")
  reportCardLetterheadUrl   String?
  letterheadContentTopMm    Int?           @default(50)
  letterheadContentBottomMm Int?           @default(30)
  allowStudentLogin         Boolean        @default(false)
  signature                 String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  teachingModel             TeachingModel?
}

// ===== ATTENDANCE =====

model Attendance {
  id         String           @id @default(uuid())
  studentId  String
  termId     String
  classId    String? // the class the register was taken for (old rows: empty)
  date       DateTime
  status     AttendanceStatus
  note       String?
  markedById String? // the LOGIN (User) id of who marked it (old rows: empty)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([classId, date])
  @@index([termId, date])
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

// ===== GRADES AND REPORT CARDS =====

model Grade {
  id             String   @id @default(uuid())
  studentId      String
  termId         String
  classSubjectId String
  caScore        Float?
  examScore      Float?
  total          Float?
  grade          String?
  remark         String?
  position       Int?
  totalStudents  Int?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id])

  @@unique([studentId, termId, classSubjectId])
}

model GradingConfig {
  id        String   @id @default(uuid())
  minScore  Float
  maxScore  Float
  grade     String
  remark    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportCard {
  id              String           @id @default(uuid())
  studentId       String
  termId          String
  status          ReportCardStatus @default(draft)
  teacherRemark   String?
  principalRemark String?
  totalScore      Float?
  averageScore    Float?
  position        Int?
  totalStudents   Int?
  pdfUrl          String?
  emailSentAt     DateTime?
  smsSentAt       DateTime?
  generatedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
}

enum ReportCardStatus {
  draft
  generated
  published
  sent
}

// ===== FEES AND PAYMENTS (v2) =====
// Money is BigInt kobo. Every invoice, payment, adjustment and refund posts to the books
// (see the ledger module); these tables hold the school-facing records.

enum FeeStudentType {
  ALL
  NEW
  RETURNING
}

enum InvoiceType {
  TERM_FEES
  ADMISSION
  ADHOC
  OPENING_BALANCE
}

// draft: not yet visible to parents and not in the books. void: cancelled after issue (journal reversed).
enum InvoiceStatus {
  draft
  unpaid
  partial
  paid
  waived
  void
}

enum FeeDiscountType {
  PERCENT
  FIXED
}

enum FeeDiscountKind {
  SIBLING
  STAFF_CHILD
  SCHOLARSHIP
  EARLY_PAYMENT
  CUSTOM
}

enum AdjustmentType {
  WAIVER
  WRITE_OFF
  CREDIT_NOTE
  ADDITIONAL_DISCOUNT
}

enum InvoiceAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstalmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentPayerType {
  GUARDIAN
  STUDENT
  OTHER
}

enum PaymentMethod {
  paystack
  flutterwave
  bank_transfer
  cash
  cheque
  pos
  other
}

enum FeePaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  CONFIRMED
  FAILED
  REVERSED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

// A kind of fee (tuition, uniform ...). Its income account is where money earned lands.
model FeeType {
  id              String    @id @default(uuid())
  code            String    @unique
  name            String
  description     String?
  incomeAccountId String
  isRefundable    Boolean   @default(false)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  incomeAccount        LedgerAccount        @relation(fields: [incomeAccountId], references: [id], onDelete: Restrict)
  structureItems       FeeStructureItem[]
  invoiceItems         FeeInvoiceItem[]
  discountRules        FeeDiscountRule[]
  invoiceDiscountLines FeeInvoiceDiscount[]

  @@index([incomeAccountId])
  @@index([isActive])
  @@index([deletedAt])
}

// What a class (or every class) is charged for one term.
model FeeStructure {
  id          String         @id @default(uuid())
  name        String
  sessionId   String
  termId      String
  classId     String?
  branchId    String?
  studentType FeeStudentType @default(ALL)
  dueDate     DateTime?      @db.Date
  description String?
  isActive    Boolean        @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  session  Session            @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  term     Term               @relation(fields: [termId], references: [id], onDelete: Restrict)
  class    Class?             @relation(fields: [classId], references: [id], onDelete: Restrict)
  branch   Branch?            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items    FeeStructureItem[]
  invoices FeeInvoice[]

  @@index([termId, classId])
  @@index([sessionId])
  @@index([branchId])
  @@index([deletedAt])
}

model FeeStructureItem {
  id          String   @id @default(uuid())
  structureId String
  feeTypeId   String
  amountKobo  BigInt
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  structure FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  feeType   FeeType      @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)

  @@unique([structureId, feeTypeId])
  @@index([feeTypeId])
}

// A bill to one student. Amounts are kept on the row and checked by the database:
// total = subtotal - discount + adjustments, balance = total - paid.
// invoiceNumber is given when the invoice is issued, never before.
model FeeInvoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String?       @unique
  type               InvoiceType   @default(TERM_FEES)
  studentId          String
  sessionId          String?
  termId             String?
  classId            String?
  branchId           String?
  sourceStructureId  String?
  lateFeeOfInvoiceId String?       @unique
  status             InvoiceStatus @default(draft)
  issueDate          DateTime?     @db.Date
  dueDate            DateTime?     @db.Date
  subtotalKobo       BigInt        @default(0)
  discountKobo       BigInt        @default(0)
  adjustmentsKobo    BigInt        @default(0)
  totalKobo          BigInt        @default(0)
  paidKobo           BigInt        @default(0)
  balanceKobo        BigInt        @default(0)
  journalId          String?       @unique
  note               String?
  version            Int           @default(1)
  voidedAt           DateTime?
  voidedById         String?
  voidReason         String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  student         Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  session         Session?             @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  term            Term?                @relation(fields: [termId], references: [id], onDelete: Restrict)
  class           Class?               @relation(fields: [classId], references: [id], onDelete: Restrict)
  branch          Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sourceStructure FeeStructure?        @relation(fields: [sourceStructureId], references: [id], onDelete: Restrict)
  journal         JournalEntry?        @relation(fields: [journalId], references: [id], onDelete: Restrict)
  items           FeeInvoiceItem[]
  discounts       FeeInvoiceDiscount[]
  adjustments     InvoiceAdjustment[]
  allocations     PaymentAllocation[]
  instalmentPlan  InstalmentPlan?
  lateFeeOf       FeeInvoice?          @relation("LateFee", fields: [lateFeeOfInvoiceId], references: [id], onDelete: Restrict)
  lateFee         FeeInvoice?          @relation("LateFee")

  @@index([studentId, status])
  @@index([termId, status])
  @@index([status, dueDate])
  @@index([branchId])
  @@index([sourceStructureId])
}

// A line on an invoice. Description and income account are copied at the time, so a later
// change to the fee type never rewrites an old invoice.
model FeeInvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  feeTypeId       String?
  description     String
  incomeAccountId String
  amountKobo      BigInt
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  invoice       FeeInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeType       FeeType?            @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  incomeAccount LedgerAccount       @relation(fields: [incomeAccountId], references: [id], onDelete: Restrict)
  adjustments   InvoiceAdjustment[]

  @@index([invoiceId])
  @@index([feeTypeId])
  @@index([incomeAccountId])
}

// A discount taken off one invoice, with the rule it came from. The label is copied, so renaming a rule
// never rewrites an old invoice. The invoice's discountKobo is the sum of these lines.
model FeeInvoiceDiscount {
  id         String   @id @default(uuid())
  invoiceId  String
  ruleId     String?
  feeTypeId  String?
  label      String
  amountKobo BigInt
  createdAt  DateTime @default(now())

  invoice FeeInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  rule    FeeDiscountRule? @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  feeType FeeType?         @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([ruleId])
}

// A reusable discount (sibling, staff child, scholarship ...). feeTypeId empty = whole invoice.
// value is basis points for PERCENT (1000 = 10%) and kobo for FIXED.
model FeeDiscountRule {
  id          String          @id @default(uuid())
  name        String
  kind        FeeDiscountKind @default(CUSTOM)
  type        FeeDiscountType
  value       BigInt
  feeTypeId   String?
  isActive    Boolean         @default(true)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  feeType          FeeType?             @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  students         StudentDiscount[]
  invoiceDiscounts FeeInvoiceDiscount[]

  @@index([isActive])
  @@index([deletedAt])
}

// Gives one student a discount rule, for a session or for good (sessionId empty).
model StudentDiscount {
  id          String    @id @default(uuid())
  studentId   String
  ruleId      String
  sessionId   String?
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  student Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  rule    FeeDiscountRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  session Session?        @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([ruleId])
  @@index([sessionId])
}

// A change to an issued invoice (waiver, write-off, credit note, extra discount).
// Needs a second person to approve; the books are touched only on approval.
// amountKobo is always positive; the type says which way it moves the invoice.
model InvoiceAdjustment {
  id                String                  @id @default(uuid())
  invoiceId         String
  type              AdjustmentType
  invoiceItemId     String?
  amountKobo        BigInt
  reason            String
  status            InvoiceAdjustmentStatus @default(PENDING)
  requestedById     String
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  firstApprovedById String?
  firstApprovedAt   DateTime?
  journalId         String?                 @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  invoice     FeeInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  invoiceItem FeeInvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)
  journal     JournalEntry?   @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([invoiceItemId])
  @@index([status])
}

model InstalmentPlan {
  id          String               @id @default(uuid())
  invoiceId   String               @unique
  status      InstalmentPlanStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  invoice FeeInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lines   InstalmentLine[]
}

model InstalmentLine {
  id         String   @id @default(uuid())
  planId     String
  lineNumber Int
  dueDate    DateTime @db.Date
  amountKobo BigInt

  plan InstalmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, lineNumber])
  @@index([dueDate])
}

// Money received. It does not belong to one invoice: allocations say where it went,
// and what is not allocated stays as the payer's credit (unallocatedKobo).
model Payment {
  id                String           @id @default(uuid())
  payerType         PaymentPayerType @default(GUARDIAN)
  guardianId        String?
  payerName         String?
  payerPhone        String?
  branchId          String?
  method            PaymentMethod
  channel           String?
  amountKobo        BigInt
  unallocatedKobo   BigInt           @default(0)
  accountId         String
  status            FeePaymentStatus @default(PENDING)
  reference         String?          @unique
  gatewayReference  String?
  webhookVerified   Boolean          @default(false)
  providerResponse  Json?
  proofAttachmentId String?
  targetStudentIds  String[]         @default([])
  clientRequestId   String?          @unique
  note              String?
  paidAt            DateTime?
  recordedById      String?
  confirmedById     String?
  confirmedAt       DateTime?
  journalId         String?          @unique
  reversedAt        DateTime?
  reversedById      String?
  reversalReason    String?
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  guardian        Guardian?              @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  branch          Branch?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  account         LedgerAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  proofAttachment Attachment?            @relation(fields: [proofAttachmentId], references: [id], onDelete: Restrict)
  journal         JournalEntry?          @relation(fields: [journalId], references: [id], onDelete: Restrict)
  allocations     PaymentAllocation[]
  refunds         Refund[]
  receipt         Receipt?
  settlementItem  GatewaySettlementItem?

  @@index([status])
  @@index([guardianId])
  @@index([accountId])
  @@index([branchId])
  @@index([createdAt])
}

// Part of a payment applied to one invoice. invoiceId empty = held as the student's credit.
model PaymentAllocation {
  id          String    @id @default(uuid())
  paymentId   String
  invoiceId   String?
  studentId   String
  amountKobo  BigInt
  reversedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  payment Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice FeeInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([invoiceId])
  @@index([studentId])
}

model Refund {
  id                String       @id @default(uuid())
  paymentId         String
  studentId         String?
  amountKobo        BigInt
  reason            String
  status            RefundStatus @default(REQUESTED)
  payoutAccountId   String?
  requestedById     String
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  firstApprovedById String?
  firstApprovedAt   DateTime?
  paidAt            DateTime?
  journalId         String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  student       Student?       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  payoutAccount LedgerAccount? @relation("RefundPayoutAccount", fields: [payoutAccountId], references: [id], onDelete: Restrict)
  journal       JournalEntry?  @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status])
  @@index([studentId])
}

// The receipt handed to the payer. The snapshot is frozen when issued.
model Receipt {
  id            String   @id @default(uuid())
  receiptNumber String   @unique
  paymentId     String   @unique
  issuedAt      DateTime @default(now())
  snapshot      Json
  createdAt     DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

// ===== SCHOOL ROLE MANAGEMENT =====

model SchoolRole {
  id                    String    @id @default(uuid())
  name                  String
  description           String?
  kind                  RoleKind
  persona               Persona   @default(STAFF)
  grantsAll             Boolean   @default(false)
  sourceTemplateKey     String?
  sourceTemplateVersion Int?
  isCustomized          Boolean   @default(false)
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  permissions SchoolRolePermission[]
  members     MembershipRole[]

  @@index([sourceTemplateKey])
}

model SchoolRolePermission {
  roleId        String
  permissionKey String
  scope         PermissionScope @default(ALL)

  role SchoolRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

// One row per portal account per persona. Contact-only guardians and students
// without logins do not need a membership.

model Membership {
  id              String           @id @default(uuid())
  userId          String
  persona         Persona
  personaEntityId String
  status          MembershipStatus @default(active)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  roles MembershipRole[]

  @@unique([userId, persona])
  @@unique([persona, personaEntityId])
  @@index([userId])
  @@index([status])
}

model MembershipRole {
  membershipId String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       SchoolRole @relation(fields: [roleId], references: [id])

  @@id([membershipId, roleId])
  @@index([roleId])
}

// ===== BRANCH MANAGEMENT =====

model Branch {
  id               String    @id @default(uuid())
  name             String
  code             String    @unique
  isMain           Boolean   @default(false)
  address          String?
  city             String?
  state            String?
  phone            String?
  email            String?
  principalStaffId String?
  isActive         Boolean   @default(true)
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  staff          StaffBranch[]
  journalEntries JournalEntry[]
  feeStructures  FeeStructure[]
  feeInvoices    FeeInvoice[]
  payments       Payment[]

  @@index([isActive])
  @@index([deletedAt])
}

// Where a staff member works. This table also determines which branches
// their BRANCH-scoped roles may access.

model StaffBranch {
  staffId      String
  branchId     String
  isPrimary    Boolean  @default(false)
  assignedAt   DateTime @default(now())
  assignedById String?

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([staffId, branchId])
  @@index([branchId])
}

// ===== SCHOOL SETTINGS OVERRIDES =====

// One row per overridden key. Deleting the row restores the platform default.

model SchoolSettingValue {
  key         String   @id
  value       Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== AUTOMATION =====

model AutomationRule {
  id            String                @id @default(uuid())
  definitionKey String
  name          String
  enabled       Boolean               @default(false)
  params        Json
  channels      NotificationChannel[]
  audience      Json?
  templateKey   String?
  schedule      Json?
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?

  runs AutomationRunLog[]

  @@index([definitionKey])
  @@index([enabled, nextRunAt])
}

model AutomationRunLog {
  id             String              @id @default(uuid())
  ruleId         String
  triggeredAt    DateTime            @default(now())
  trigger        String
  status         AutomationRunStatus
  matched        Int                 @default(0)
  notified       Int                 @default(0)
  skippedReason  String?
  error          String?
  notificationId String?

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, triggeredAt])
}

enum AutomationRunStatus {
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

// ===== SCHOOL MESSAGE TEMPLATES =====

model SchoolMessageTemplate {
  id          String              @id @default(uuid())
  key         String
  channel     NotificationChannel
  locale      String              @default("en")
  subject     String?
  body        String
  isActive    Boolean             @default(true)
  updatedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([key, channel, locale])
  @@index([isActive])
}

// ===== NUMBER SEQUENCES =====

// Gapless per-school counters for admission numbers, invoices, receipts, and payslips.
// The period resets a counter; an empty string means the counter never resets.

model NumberSequence {
  key       String
  period    String   @default("")
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  @@id([key, period])
}

// ===== ATTACHMENTS =====

// Shared file metadata for student and staff documents, receipts, payslips, and letters.
// sizeBytes can be used as the storage entitlement meter source.

model Attachment {
  id           String    @id @default(uuid())
  ownerType    String
  ownerId      String
  kind         String
  fileName     String
  fileUrl      String
  mimeType     String?
  sizeBytes    Int       @default(0)
  uploadedById String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  paymentProofs Payment[]

  @@index([ownerType, ownerId])
  @@index([deletedAt])
}

// ===== SCHOOL NOTIFICATIONS =====

model SchoolNotification {
  id         String                 @id @default(uuid())
  title      String
  message    String
  type       SchoolNotificationType
  targetType TargetType
  sentById   String
  metadata   Json?
  sentAt     DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  recipients SchoolNotificationRecipient[]

  @@index([type])
  @@index([createdAt(sort: Desc)])
}

model SchoolNotificationRecipient {
  id                String               @id @default(uuid())
  notificationId    String
  recipientType     RecipientType
  recipientEntityId String
  userId            String?
  channel           NotificationChannel
  status            DeliveryStatus       @default(PENDING)
  priority          NotificationPriority @default(NORMAL)
  retryCount        Int                  @default(0)
  failedReason      String?
  providerMsgId     String?
  idempotencyKey    String?              @unique
  queuedAt          DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  nextRetryAt       DateTime?
  readAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  notification SchoolNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel, recipientType, recipientEntityId])
  @@index([status])
  @@index([status, priority, createdAt])
  @@index([recipientType, recipientEntityId])
}

enum SchoolNotificationType {
  fee_invoice
  fee_reminder
  fee_receipt
  report_card_ready
  attendance_alert
  event
  holiday
  broadcast
  custom
}

enum RecipientType {
  STUDENT
  GUARDIAN
  STAFF
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TargetType {
  STUDENT
  GUARDIAN
  STAFF
  ALL_PARENTS
  ALL_STUDENTS
  ALL_STAFF
  EVERYONE
}

// ===========================================================================
// FINANCE: THE BOOKS  (owned by the Finance workspace; see FINANCE_MODULE_BRIEF.md)
// Money is whole kobo in BigInt. Accounting dates are calendar dates (DATE), so a Nigerian
// midnight never slips to the day before. A posted journal can never be edited or deleted
// (database triggers in the finance_books migration); a mistake is fixed by a reversal.
// Only the finance workspace edits this block. The back-relation lines this block needs
// (journalEntries on Branch, Term and Session) are the only edits outside it.
// ===========================================================================

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalStatus {
  POSTED
  REVERSED
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum JournalSourceType {
  FEE_INVOICE
  PAYMENT
  REFUND
  ADJUSTMENT
  EXPENSE_BILL
  EXPENSE_PAYMENT
  PAYROLL_ACCRUAL
  PAYROLL_PAYMENT
  PAYROLL_REMITTANCE
  TRANSFER
  OPENING_BALANCE
  MANUAL
  REVERSAL
}

// Who a journal line is about, so reports can show who owes what
enum LedgerPartyType {
  STUDENT
  GUARDIAN
  VENDOR
  STAFF
}

// A labeled bucket in the school's books: Cash, Tuition Income, Salaries ...
// One chart of accounts per school (branches share it; a journal records its branch).
model LedgerAccount {
  id                 String            @id @default(uuid())
  code               String            @unique
  name               String
  type               LedgerAccountType
  subtype            String            @default("GENERAL")
  systemKey          String?           @unique
  parentId           String?
  description        String?
  isMoneyAccount     Boolean           @default(false)
  bankName           String?
  accountName        String?
  accountNumberLast4 String?
  isActive           Boolean           @default(true)
  isLocked           Boolean           @default(false)
  sortOrder          Int               @default(0)
  createdById        String?
  updatedById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  parent   LedgerAccount?  @relation("LedgerAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children LedgerAccount[] @relation("LedgerAccountTree")
  lines    JournalLine[]

  feeTypes      FeeType[]
  invoiceItems  FeeInvoiceItem[]
  payments      Payment[]
  refundPayouts Refund[]         @relation("RefundPayoutAccount")

  expenseLines     ExpenseLine[]
  expensePayFrom   Expense[]          @relation("ExpensePayFrom")
  expensePayments  ExpensePayment[]
  budgetLines      BudgetLine[]
  recurringPayFrom RecurringExpense[] @relation("RecurringPayFrom")

  bankStatements      BankStatement[]
  bankMatchGroups     BankMatchGroup[]
  bankReconciliations BankReconciliation[]
  gatewaySettlements  GatewaySettlement[]
  salaryTransfersFrom SalaryTransfer[]     @relation("SalaryTransferFrom")

  @@index([type])
  @@index([parentId])
  @@index([isActive])
  @@index([deletedAt])
}

// An accounting month. A closed period cannot receive postings.
model FinancePeriod {
  id           String       @id @default(uuid())
  name         String       @unique
  startDate    DateTime     @unique @db.Date
  endDate      DateTime     @db.Date
  status       PeriodStatus @default(OPEN)
  closedAt     DateTime?
  closedById   String?
  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  journals            JournalEntry[]
  bankReconciliations BankReconciliation[]
}

// One money event. Immutable once posted; only status may change (POSTED to REVERSED).
// idempotencyKey is built by the posting service from source type, source id and purpose,
// so the same event can never post twice. A reversal points back at the journal it undoes.
model JournalEntry {
  id             String            @id @default(uuid())
  number         String            @unique
  entryDate      DateTime          @db.Date
  periodId       String
  termId         String?
  sessionId      String?
  branchId       String?
  description    String
  sourceType     JournalSourceType
  sourceId       String?
  purpose        String
  idempotencyKey String            @unique
  status         JournalStatus     @default(POSTED)
  reversalOfId   String?           @unique
  reversalReason String?
  totalKobo      BigInt
  createdById    String?
  isSystemActor  Boolean           @default(false)
  postedAt       DateTime          @default(now())
  createdAt      DateTime          @default(now())

  period     FinancePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  term       Term?         @relation(fields: [termId], references: [id], onDelete: Restrict)
  session    Session?      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  branch     Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reversalOf JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry? @relation("JournalReversal")
  lines      JournalLine[]

  feeInvoice        FeeInvoice?
  payment           Payment?
  gatewaySettlement GatewaySettlement?
  salaryTransfer    SalaryTransfer?    @relation("SalaryTransferJournal")
  adjustment        InvoiceAdjustment?
  refund            Refund?
  expense           Expense?
  expensePayment    ExpensePayment?
  runAccrual        PayrollRun?        @relation("RunAccrual")
  runPayment        PayrollRun?        @relation("RunPayment")
  loanDisbursed     StaffLoan?
  remittance        PayrollRemittance?

  @@index([periodId])
  @@index([entryDate])
  @@index([sourceType, sourceId])
  @@index([termId])
  @@index([branchId])
}

// One account moved by a journal, on the debit side or the credit side (never both).
// The database enforces: exactly one side above zero, and debits equal credits per journal.
model JournalLine {
  id              String           @id @default(uuid())
  journalId       String
  lineNumber      Int
  ledgerAccountId String
  debitKobo       BigInt           @default(0)
  creditKobo      BigInt           @default(0)
  memo            String?
  partyType       LedgerPartyType?
  partyId         String?

  journal       JournalEntry            @relation(fields: [journalId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount           @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  bankMatch     BankMatchedJournalLine?

  @@unique([journalId, lineNumber])
  @@index([ledgerAccountId, journalId])
  @@index([partyType, partyId])
}

// ===== FINANCE: EXPENSES, BILLS AND BUDGETS (phase 3) =====

enum ExpenseKind {
  DIRECT // paid at once, when approved
  BILL // owed to a supplier; paid later, in one or more payments
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_PAID
  PAID
  REJECTED
  VOID
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  TERMLY
  YEARLY
}

enum BudgetStatus {
  DRAFT
  ACTIVE
  CLOSED
}

// A supplier. The bank account number is stored encrypted; only the last four digits are shown.
model Vendor {
  id                     String    @id @default(uuid())
  name                   String
  contactName            String?
  phone                  String?
  email                  String?
  address                String?
  bankName               String?
  accountName            String?
  accountNumberEncrypted String?
  accountNumberLast4     String?
  taxId                  String?
  notes                  String?
  isActive               Boolean   @default(true)
  createdById            String?
  updatedById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
}

// Money the school spends. DIRECT is paid when approved; BILL is owed to the supplier (accounts payable) until paid.
// The number is given when it is submitted, so drafts leave no gaps. Amounts are whole kobo.
model Expense {
  id                 String        @id @default(uuid())
  expenseNumber      String?       @unique
  kind               ExpenseKind
  vendorId           String?
  reference          String?
  description        String
  expenseDate        DateTime      @db.Date
  dueDate            DateTime?     @db.Date
  totalKobo          BigInt
  paidKobo           BigInt        @default(0)
  status             ExpenseStatus @default(DRAFT)
  payFromAccountId   String?
  termId             String?
  branchId           String?
  recurringExpenseId String?
  requestedById      String
  submittedAt        DateTime?
  approvedById       String?
  approvedAt         DateTime?
  firstApprovedById  String?
  firstApprovedAt    DateTime?
  autoApproved       Boolean       @default(false)
  rejectedById       String?
  rejectedAt         DateTime?
  rejectionReason    String?
  voidReason         String?
  voidedById         String?
  voidedAt           DateTime?
  journalId          String?       @unique
  version            Int           @default(1)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  vendor         Vendor?           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  payFromAccount LedgerAccount?    @relation("ExpensePayFrom", fields: [payFromAccountId], references: [id], onDelete: Restrict)
  recurring      RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: Restrict)
  journal        JournalEntry?     @relation(fields: [journalId], references: [id], onDelete: Restrict)
  lines          ExpenseLine[]
  payments       ExpensePayment[]

  @@unique([recurringExpenseId, expenseDate]) // a repeat run never makes the same expense twice
  @@index([status])
  @@index([kind])
  @@index([vendorId])
  @@index([expenseDate])
  @@index([dueDate])
  @@index([requestedById])
  @@index([recurringExpenseId])
}

model ExpenseLine {
  id              String @id @default(uuid())
  expenseId       String
  ledgerAccountId String
  description     String
  amountKobo      BigInt
  vatKobo         BigInt @default(0)
  sortOrder       Int    @default(0)

  expense       Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([expenseId])
  @@index([ledgerAccountId])
}

// One payment out for an expense (a DIRECT expense has exactly one). A reversed payment keeps its row.
model ExpensePayment {
  id            String        @id @default(uuid())
  expenseId     String
  amountKobo    BigInt
  paidOn        DateTime      @db.Date
  accountId     String
  method        PaymentMethod
  reference     String?
  paidById      String
  journalId     String        @unique
  reversedAt    DateTime?
  reversedById  String?
  reverseReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  expense Expense       @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  journal JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([expenseId])
  @@index([paidOn])
  @@index([accountId])
}

// A bill or expense that repeats. A daily job makes a draft (or an approved one) when nextRunDate arrives.
// lines is a list of { ledgerAccountId, description, amountKobo (digit string) }.
model RecurringExpense {
  id               String              @id @default(uuid())
  vendorId         String?
  kind             ExpenseKind         @default(BILL)
  payFromAccountId String?
  description      String
  lines            Json
  frequency        RecurrenceFrequency
  startDate        DateTime            @db.Date
  endDate          DateTime?           @db.Date
  nextRunDate      DateTime            @db.Date
  lastRunAt        DateTime?
  autoApprove      Boolean             @default(false)
  isActive         Boolean             @default(true)
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  vendor         Vendor?        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  payFromAccount LedgerAccount? @relation("RecurringPayFrom", fields: [payFromAccountId], references: [id], onDelete: Restrict)
  expenses       Expense[]

  @@index([isActive, nextRunDate])
}

// What the school plans to earn and spend, to compare with what the books show.
model Budget {
  id          String       @id @default(uuid())
  name        String
  sessionId   String?
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  status      BudgetStatus @default(DRAFT)
  createdById String
  updatedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  lines BudgetLine[]

  @@index([status])
  @@index([startDate, endDate])
  @@index([deletedAt])
}

model BudgetLine {
  id              String   @id @default(uuid())
  budgetId        String
  ledgerAccountId String
  termId          String?
  plannedKobo     BigInt
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  budget        Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([budgetId])
  @@index([ledgerAccountId])
}

// ──────────────────────────────────────────────────────────────────────────
// FINANCE PHASE 5: PAYROLL (sensitive). Amounts are whole kobo; rates are basis points (1000 = 10.00%).
// The school's accountant sets the rules as data; nothing statutory is hardcoded. Staff and ledger accounts are
// referenced by plain id and checked in code (Finance only reads Staff and adds nothing to it).
// ──────────────────────────────────────────────────────────────────────────

enum PayComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum PayCalcType {
  FIXED
  PERCENT_OF_BASIC
  PERCENT_OF_GROSS
  BANDED
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  FINAL
  PAID
  VOID
}

enum LoanStatus {
  ACTIVE
  CLEARED
  CANCELLED
}

// An earning, deduction or employer contribution. defaultValue is kobo for FIXED and basis points for the percent types.
// bands (BANDED only): [{ "upToKobo": "30000000" | null, "rateBp": 700 }, ...] applied progressively to the month's taxable pay.
model PayComponent {
  id                 String           @id @default(uuid())
  name               String
  code               String           @unique
  type               PayComponentType
  calcType           PayCalcType
  defaultValue       BigInt           @default(0)
  bands              Json?
  isTaxable          Boolean          @default(false)
  isStatutory        Boolean          @default(false)
  expenseAccountId   String?
  liabilityAccountId String?
  isActive           Boolean          @default(true)
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  staffComponents StaffPayComponent[]

  @@index([type])
  @@index([isActive])
  @@index([deletedAt])
}

// What one staff member is paid, from a date. History is kept as dated rows; the current row has no end date.
model StaffPayProfile {
  id                     String    @id @default(uuid())
  staffId                String
  effectiveFrom          DateTime  @db.Date
  effectiveTo            DateTime? @db.Date
  basicSalaryKobo        BigInt
  payFrequency           String    @default("MONTHLY")
  bankCode               String?
  bankName               String?
  accountName            String?
  accountNumberEncrypted String?
  accountNumberLast4     String?
  taxId                  String?
  pensionId              String?
  isActive               Boolean   @default(true)
  createdById            String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  components StaffPayComponent[]

  @@index([staffId, effectiveFrom])
}

model StaffPayComponent {
  id            String  @id @default(uuid())
  profileId     String
  componentId   String
  valueOverride BigInt?
  isActive      Boolean @default(true)

  profile   StaffPayProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  component PayComponent    @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([profileId, componentId])
  @@index([componentId])
}

// One month's pay for everyone. Only one run per month that is not cancelled (checked in code). Money is posted when it is approved and when it is paid.
model PayrollRun {
  id                String           @id @default(uuid())
  runNumber         String           @unique
  periodYear        Int
  periodMonth       Int
  payDate           DateTime         @db.Date
  status            PayrollRunStatus @default(DRAFT)
  grossKobo         BigInt           @default(0)
  deductionsKobo    BigInt           @default(0)
  employerCostKobo  BigInt           @default(0)
  netKobo           BigInt           @default(0)
  staffCount        Int              @default(0)
  calculatedAt      DateTime?
  createdById       String
  submittedAt       DateTime?
  firstApprovedById String?
  firstApprovedAt   DateTime?
  approvedById      String?
  approvedAt        DateTime?
  rejectedById      String?
  rejectedAt        DateTime?
  rejectionReason   String?
  paidAt            DateTime?
  paidById          String?
  paidOn            DateTime?        @db.Date
  paidFromAccountId String?
  paymentReference  String?
  accrualJournalId  String?          @unique
  paymentJournalId  String?          @unique
  cancelledAt       DateTime?
  cancelledById     String?
  cancelReason      String?
  notes             String?
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  accrualJournal  JournalEntry?    @relation("RunAccrual", fields: [accrualJournalId], references: [id], onDelete: Restrict)
  paymentJournal  JournalEntry?    @relation("RunPayment", fields: [paymentJournalId], references: [id], onDelete: Restrict)
  payslips        Payslip[]
  salaryTransfers SalaryTransfer[]

  @@index([periodYear, periodMonth])
  @@index([status])
}

// One staff member's pay for a run. Numbered and frozen (snapshot) when the run is approved.
model Payslip {
  id                       String        @id @default(uuid())
  runId                    String
  staffId                  String
  payslipNumber            String?       @unique
  grossKobo                BigInt
  totalDeductionsKobo      BigInt
  netKobo                  BigInt
  employerContributionKobo BigInt        @default(0)
  status                   PayslipStatus @default(DRAFT)
  paidAt                   DateTime?
  paymentReference         String?
  snapshot                 Json?
  emailedAt                DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  run             PayrollRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  lines           PayslipLine[]
  salaryTransfers SalaryTransfer[]

  @@unique([runId, staffId])
  @@index([staffId])
}

// kind: BASIC (the basic salary), COMPONENT (a pay component) or LOAN (a loan repayment). The accounts are copied from the component when pay is calculated.
model PayslipLine {
  id                 String           @id @default(uuid())
  payslipId          String
  kind               String           @default("COMPONENT")
  componentId        String?
  loanId             String?
  label              String
  type               PayComponentType
  amountKobo         BigInt
  expenseAccountId   String?
  liabilityAccountId String?
  sortOrder          Int              @default(0)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}

model StaffLoan {
  id                    String     @id @default(uuid())
  staffId               String
  principalKobo         BigInt
  balanceKobo           BigInt
  monthlyRepaymentKobo  BigInt
  startYear             Int
  startMonth            Int
  status                LoanStatus @default(ACTIVE)
  reason                String?
  approvedById          String
  disbursedOn           DateTime   @db.Date
  paidFromAccountId     String
  disbursementJournalId String     @unique
  cancelledAt           DateTime?
  cancelledById         String?
  cancelReason          String?
  version               Int        @default(1)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  disbursementJournal JournalEntry         @relation(fields: [disbursementJournalId], references: [id], onDelete: Restrict)
  repayments          StaffLoanRepayment[]

  @@index([staffId])
  @@index([status])
}

model StaffLoanRepayment {
  id         String    @id @default(uuid())
  loanId     String
  payslipId  String
  amountKobo BigInt
  reversedAt DateTime?
  createdAt  DateTime  @default(now())

  loan StaffLoan @relation(fields: [loanId], references: [id], onDelete: Restrict)

  @@unique([loanId, payslipId])
}

// Tax or pension paid over to the authority: debit the liability account, credit the money account.
model PayrollRemittance {
  id                 String    @id @default(uuid())
  liabilityAccountId String
  periodYear         Int
  periodMonth        Int
  amountKobo         BigInt
  paidOn             DateTime  @db.Date
  fromAccountId      String
  reference          String?
  note               String?
  journalId          String    @unique
  createdById        String
  reversedAt         DateTime?
  reversedById       String?
  reverseReason      String?
  createdAt          DateTime  @default(now())

  journal JournalEntry @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([periodYear, periodMonth])
}

// ===== FINANCE: BANK RECONCILIATION (phase 6) =====
// A bank statement is imported as signed lines (money in is positive, money out is negative) and each line is paired with the
// journal line(s) that record the same money. A month is signed off per money account with BankReconciliation.

enum BankMatchKind {
  AUTO // paired by the system: same amount, close dates, no other candidate as good
  MANUAL // paired by a person
  CREATED // the books did not have it: a journal was made from the bank line (a charge, interest)
  CLEARED // a book entry with no bank line, set aside with a reason (an opening balance from before the statements start)
}

// One uploaded file. The same file cannot be imported twice for one account.
model BankStatement {
  id                 String   @id @default(uuid())
  ledgerAccountId    String
  fileName           String?
  fileHash           String
  startDate          DateTime @db.Date
  endDate            DateTime @db.Date
  openingBalanceKobo BigInt?
  closingBalanceKobo BigInt?
  lineCount          Int
  importedById       String?
  importedAt         DateTime @default(now())

  ledgerAccount LedgerAccount       @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  lines         BankStatementLine[]

  @@unique([ledgerAccountId, fileHash])
  @@index([ledgerAccountId, endDate])
}

// One transaction as the bank printed it. dedupeKey stops an overlapping upload creating it twice.
model BankStatementLine {
  id              String   @id @default(uuid())
  statementId     String
  ledgerAccountId String
  lineNumber      Int
  txnDate         DateTime @db.Date
  description     String
  reference       String?
  amountKobo      BigInt
  balanceKobo     BigInt?
  dedupeKey       String
  matchGroupId    String?
  createdAt       DateTime @default(now())

  statement  BankStatement   @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchGroup BankMatchGroup? @relation(fields: [matchGroupId], references: [id], onDelete: SetNull)

  @@unique([ledgerAccountId, dedupeKey])
  @@index([ledgerAccountId, txnDate])
  @@index([statementId])
  @@index([matchGroupId])
}

// A pairing: the bank lines and the journal lines in it add up to the same amount.
model BankMatchGroup {
  id              String        @id @default(uuid())
  ledgerAccountId String
  kind            BankMatchKind
  note            String?
  createdById     String?
  createdAt       DateTime      @default(now())

  ledgerAccount LedgerAccount            @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  bankLines     BankStatementLine[]
  journalLines  BankMatchedJournalLine[]

  @@index([ledgerAccountId, createdAt])
}

// A journal line can be in at most one pairing (the primary key), so it can never be counted twice.
model BankMatchedJournalLine {
  journalLineId String @id
  groupId       String

  group       BankMatchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  journalLine JournalLine    @relation(fields: [journalLineId], references: [id], onDelete: Restrict)

  @@index([groupId])
}

// The sign-off: this money account agreed with its bank at the end of this month. Reopening deletes the row (the audit trail keeps why).
model BankReconciliation {
  id                   String   @id @default(uuid())
  ledgerAccountId      String
  periodId             String
  statementBalanceKobo BigInt
  bookBalanceKobo      BigInt
  outstandingBookKobo  BigInt
  note                 String?
  completedById        String?
  completedAt          DateTime @default(now())

  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  period        FinancePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([ledgerAccountId, periodId])
  @@index([periodId])
}

// ============================================================================
// FINANCE: GATEWAY SETTLEMENTS (phase 6)
// ============================================================================

// One payout from the payment gateway to the school's bank. The journal is Dr bank (net) + Dr bank charges (fee) / Cr online clearing (gross).
model GatewaySettlement {
  id            String    @id @default(uuid())
  provider      String    @default("paystack")
  reference     String
  settledOn     DateTime  @db.Date
  grossKobo     BigInt
  feeKobo       BigInt
  netKobo       BigInt
  accountId     String
  journalId     String    @unique
  itemCount     Int
  note          String?
  recordedById  String?
  createdAt     DateTime  @default(now())
  reversedAt    DateTime?
  reversedById  String?
  reverseReason String?

  account LedgerAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  journal JournalEntry            @relation(fields: [journalId], references: [id], onDelete: Restrict)
  items   GatewaySettlementItem[]

  @@unique([provider, reference])
  @@index([settledOn])
}

// An online payment that a settlement paid out. A payment can be in at most one live settlement (reversing the settlement deletes these rows).
model GatewaySettlementItem {
  id           String @id @default(uuid())
  settlementId String
  paymentId    String @unique
  amountKobo   BigInt
  feeKobo      BigInt

  settlement GatewaySettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  payment    Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([settlementId])
}

// ============================================================================
// PAYROLL: SALARY TRANSFERS (phase 6). One row per attempt to pay one payslip by bank transfer.
// The row exists BEFORE the provider is called; only a confirmed outcome (webhook or verify) makes it SUCCESS and posts the books.
// ============================================================================

enum SalaryTransferStatus {
  PENDING // created, nothing sent
  SENDING // claimed by a sender, the provider call is in flight
  PROCESSING // the provider accepted it and is still moving the money
  UNKNOWN // the provider call ended without an answer: never resend, verify
  SUCCESS // confirmed paid
  FAILED // confirmed not paid (a retry makes a new attempt)
  REVERSED // paid, then returned by the bank
  CANCELLED // stopped before sending
}

model SalaryTransfer {
  id                     String               @id @default(uuid())
  runId                  String
  payslipId              String
  staffId                String
  attempt                Int                  @default(1)
  reference              String               @unique
  amountKobo             BigInt
  status                 SalaryTransferStatus @default(PENDING)
  bankCode               String
  bankName               String?
  accountName            String
  accountNumberEncrypted String
  accountLast4           String
  recipientCode          String?
  transferCode           String?
  fromAccountId          String
  failureReason          String?
  initiatedById          String
  sentAt                 DateTime?
  confirmedAt            DateTime?
  journalId              String?              @unique
  reversalJournalId      String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  run         PayrollRun    @relation(fields: [runId], references: [id], onDelete: Restrict)
  payslip     Payslip       @relation(fields: [payslipId], references: [id], onDelete: Restrict)
  fromAccount LedgerAccount @relation("SalaryTransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  journal     JournalEntry? @relation("SalaryTransferJournal", fields: [journalId], references: [id], onDelete: Restrict)

  @@unique([payslipId, attempt])
  @@index([runId])
  @@index([status])
}

// ── Grades setup: grading scales and assessment schemes, one per level (level empty = the default for all levels) ──
enum AssessmentKind {
  ca
  exam
}

model GradingScale {
  id        String   @id @default(uuid())
  name      String
  level     String? // primary | jss | ss, or empty for the default. One scale per level (SQL unique index)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bands GradingBand[]
}

// A band starts at minScore and runs up to the next band's minScore (the top band reaches 100)
model GradingBand {
  id        String   @id @default(uuid())
  scaleId   String
  minScore  Float
  grade     String
  remark    String
  isPass    Boolean  @default(true)
  createdAt DateTime @default(now())

  scale GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, minScore])
}

model AssessmentScheme {
  id        String   @id @default(uuid())
  name      String
  level     String? // primary | jss | ss, or empty for the default. One scheme per level (SQL unique index)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components AssessmentComponent[]
}

// The maximum scores of one scheme's components add up to 100
model AssessmentComponent {
  id        String         @id @default(uuid())
  schemeId  String
  name      String
  kind      AssessmentKind
  maxScore  Float
  position  Int
  createdAt DateTime       @default(now())

  scheme AssessmentScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, position])
}
