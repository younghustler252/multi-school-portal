{
    "compilerOptions": {
        "target":                          "ES2020",
        "module":                          "commonjs",
        "rootDir":                         "src",
        "outDir":                          "dist",
        "strict":                          true,
        "esModuleInterop":                 true,
        "skipLibCheck":                    true,
        "forceConsistentCasingInFileNames": true,
        
        // "typeRoots": [
        //     "./node_modules/@types",
        //     "./src/shared/types"
        // ]
    },
    "types": [
      "node" 
    ],
    "include":  ["src/**/*", "src/worker.ts", "staff-module-v1/shared/context"],
    "exclude": ["node_modules", "dist"],
    "ts-node": {
        "files": true
    }
    
}