{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module":  "commonjs",
        "rootDir": "src",
        "outDir":  "dist"
    },
    "include": ["src/**/*"],
    "exclude": [
        "node_modules", "dist",
        // Unfinished or unmounted code that nothing imports and that does not compile yet.
        // Remove a line when its owner finishes the module, so the compiler checks it again.
        "src/modules/super-admin"                               // not mounted (see routes/index.ts and container/index.ts); imports files that do not exist
    ],
    "ts-node": { "files": true }
}
