 }
+
+// ── Mark sheets: one subject, in one class, for one term ──
+enum ResultSheetStatus {
+  draft
+  submitted
+  approved
+  published
+  locked
+}
+
+model ResultSheet {
+  id             String            @id @default(uuid())
+  classSubjectId String            @unique
+  status         ResultSheetStatus @default(draft)
+  components     Json              // the parts of the score, copied from the school's scheme when the sheet is created: [{ position, name, kind, maxScore }]
+  scale          Json?             // the grading scale used, frozen when published: [{ minScore, grade, remark, isPass }]
+  submittedAt    DateTime?
+  submittedById  String?
+  approvedAt     DateTime?
+  approvedById   String?
+  publishedAt    DateTime?
+  publishedById  String?
+  lockedAt       DateTime?
+  lockedById     String?
+  reopenedAt     DateTime?
+  reopenedById   String?
+  reopenReason   String?
+  createdAt      DateTime          @default(now())
+  updatedAt      DateTime          @updatedAt
+
+  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id])
+  grades       Grade[]
+
+  @@index([status])
+}
+
+// One score of one student for one part (position) of the sheet's scheme. Not entered = no row or an empty score.
+model GradeScore {
+  id       String  @id @default(uuid())
+  gradeId  String
+  position Int
+  score    Float?
+  isAbsent Boolean @default(false)
+
+  grade Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
+
+  @@unique([gradeId, position])
+}
