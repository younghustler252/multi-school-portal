+        await assert.rejects(new UpdateClassUseCase(deps).execute("s", C2, { branchId: NORTH }, actor), { code: "CLASS_BRANCH_PROGRESSION" });   // from the other end too
+        const unlinked = fakes({ links: [{ fromClassId: C2, toClassId: null }] });
