generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/public"
}

datasource db {
  provider = "postgresql"
}

// ===== PLATFORM AUTHORITY =====

enum LegacyPlatformRole {
  super_admin
}

enum Role {
  super_admin
  school_admin
  principal
  teacher
  bursar
  student
  guardian
}

enum Persona {
  STAFF
  STUDENT
  GUARDIAN
}

enum MemberStatus {
  active
  suspended
  removed
}

enum PlatformRoleKind {
  LOCKED
  CUSTOM
}

enum PermissionScope {
  ALL
  BRANCH
  ASSIGNED
  OWN
}

enum PermissionRealm {
  PLATFORM
  SCHOOL
}

enum SchoolCategory {
  primary
  secondary
  primary_secondary
}

enum SchoolOwnership {
  private
  public
  mission
  international
}

enum SchoolStatus {
  pending
  active
  suspended
  deactivated
}

enum VerificationStatus {
  unverified
  under_review
  verified
  rejected
}

enum IdDocumentType {
  nin
  voters_card
  drivers_license
  international_passport
  other
}

enum DocumentType {
  cac_certificate
  proprietor_id
  waec_approval
  ministry_approval
  other
}

enum DocumentStatus {
  pending
  under_review
  approved
  rejected
}

enum OtpType {
  email_verification
  password_reset
  two_factor
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
  expired
}

enum BillingCycle {
  monthly
  yearly
}

enum DiscountType {
  percentage
  fixed_amount
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum BillingInvoiceStatus {
  open
  paid
  void
  uncollectible
}

enum BillingInvoiceReason {
  upgrade
  renewal
  adjustment
}

enum BillingItemKind {
  plan
  setup_fee
  proration_credit
  discount
  adjustment
}

enum PaymentAttemptStatus {
  pending
  success
  failed
  abandoned
}

enum PaymentAttemptMethod {
  checkout
  saved_card
  manual
}

enum WebhookEventStatus {
  received
  processed
  ignored
  failed
}

enum FeatureKind {
  BOOLEAN
  LIMIT
  QUOTA
  ENUM
}

enum Enforcement {
  BLOCK
  WARN
}

enum DefinitionOrigin {
  CODE
  PLATFORM
}

enum SettingType {
  BOOLEAN
  INTEGER
  DECIMAL
  STRING
  ENUM
  TIME
  STRING_LIST
  INTEGER_LIST
  ENTITY_REF
}

enum AutomationTrigger {
  EVENT
  SCHEDULE
  OFFSET_BEFORE
  OFFSET_AFTER
}

enum TemplateCategory {
  AUTH
  BILLING
  SYSTEM
  FEES
  ACADEMIC
  ATTENDANCE
  GENERAL
}

enum ActorType {
  user
  system
  super_admin
  webhook
}

enum PlatformNotificationType {
  welcome
  feature_announcement
  subscription_expiry
  subscription_renewed
  subscription_failed
  account_suspended
  account_verified
  account_rejected
  system_alert
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationState {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum FeedbackType {
  bug
  suggestion
  complaint
  praise
}

enum FeedbackStatus {
  open
  reviewed
  resolved
}

// ===== SCHOOL =====

model School {
  // Primary identifier
  id   String @id @default(uuid())
  name String

  // Domain and contact information
  subdomain              String    @unique
  customDomain           String?
  customDomainVerifiedAt DateTime?
  email                  String    @unique
  phone                  String?
  website                String?
  logoUrl                String?

  // Address information
  address  String?
  city     String?
  state    String?
  country  String  @default("Nigeria")
  timezone String  @default("Africa/Lagos")

  // School classification
  schoolCategory  SchoolCategory  @default(primary)
  schoolOwnership SchoolOwnership @default(private)

  // Status and verification
  status             SchoolStatus       @default(pending)
  verificationStatus VerificationStatus @default(unverified)
  verificationNote   String?
  verifiedAt         DateTime?
  verifiedById       String?
  activatedAt        DateTime?
  isActive           Boolean            @default(false)

  // Suspension and deletion
  suspendedAt      DateTime?
  suspensionReason String?
  deletedAt        DateTime?

  // Multi-tenant schema provisioning
  schemaName          String?   @unique
  schemaProvisionedAt DateTime?

  // Paystack settlement information
  paystackSubaccountCode  String?
  paystackSubaccountId    String?
  settlementBankCode      String?
  settlementAccountNumber String?
  settlementAccountName   String?
  settlementAccountLast4  String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  users                          User[]
  userSchools                    UserSchool[]
  subscriptions                  Subscription[]
  documents                      SchoolDocument[]
  auditLogs                      AuditLog[]
  platformNotificationRecipients PlatformNotificationRecipient[]
  entitlementOverrides           SchoolEntitlementOverride[]
  feedback                       Feedback[]
  subscriptionInvoices           SubscriptionInvoice[]
  paymentMethods                 PaymentMethod[]

  // Indexes
  @@index([status])
  @@index([status, activatedAt])
  @@index([deletedAt])
}

model SchoolDocument {
  id                    String          @id @default(uuid())
  schoolId              String
  type                  DocumentType
  idDocumentType        IdDocumentType?
  idNumber              String?
  proprietorFullName    String?
  proprietorDateOfBirth DateTime?
  fileUrl               String
  status                DocumentStatus  @default(pending)
  rejectionReason       String?
  verifiedAt            DateTime?
  verifiedById          String?
  apiVerified           Boolean         @default(false)
  apiResponse           Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

// ===== AUTH / IDENTITY MODULE =====

model User {
  id String @id @default(uuid())

  // Legacy tenant context retained until the final migration stage.
  schoolId String?

  email        String @unique
  passwordHash String

  // Legacy authorization fields retained during migration.
  role         Role
  platformRole LegacyPlatformRole?

  firstName String?
  lastName  String?
  phone     String?
  photoUrl  String?

  isActive           Boolean   @default(true)
  isEmailVerified    Boolean   @default(false)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  mustChangePassword Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school         School?         @relation(fields: [schoolId], references: [id])
  platformMember PlatformMember?
  schools        UserSchool[]
  refreshTokens  RefreshToken[]
  otps           Otp[]
  invitesSent    Invite[]        @relation("InviteSender")
  feedback       Feedback[]

  @@index([schoolId])
  @@index([platformRole])
}

model UserSchool {
  userId    String
  schoolId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, schoolId])
  @@index([schoolId])
}

model Otp {
  id String @id @default(uuid())

  userId String
  code   String
  type   OtpType

  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model RefreshToken {
  id             String    @id @default(uuid())
  userId         String
  token          String    @unique // HMAC of the JWT
  familyId       String
  schoolId       String?
  membershipId   String?
  impersonatorId String?
  userAgent      String?
  ipAddress      String?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  replacedById   String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Invite {
  id String @id @default(uuid())

  email String

  // Legacy role retained until the final migration stage.
  role Role

  persona         Persona   @default(STAFF)
  personaEntityId String?
  roleId          String?
  roleKey         String?
  token           String    @unique
  schoolId        String
  sentById        String
  accepted        Boolean   @default(false)
  acceptedAt      DateTime?
  revokedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  sentBy User @relation("InviteSender", fields: [sentById], references: [id])

  @@index([schoolId, email])
  @@index([roleId])
  @@index([roleKey])
  @@index([expiresAt])
}

// ===== BILLING / SUBSCRIPTION MODULE =====

model Plan {
  id          String  @id @default(uuid())
  name        String  @unique
  systemKey   String? @unique
  description String?

  // Legacy fields retained until final cleanup
  studentLimit Int  @default(0)
  staffLimit   Int  @default(0)
  features     Json @default("{}")

  // Pricing
  monthlyPriceKobo Int @default(0)
  yearlyPriceKobo  Int @default(0)
  setupFeeKobo     Int @default(0)

  // Availability and plan type
  isPublic Boolean @default(true)
  isActive Boolean @default(true)
  isCustom Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  subscriptions Subscription[]
  entitlements  PlanEntitlement[]
  invoices      SubscriptionInvoice[]
}

model Subscription {
  id                  String             @id @default(uuid())
  schoolId            String
  planId              String
  status              SubscriptionStatus @default(active)
  billingCycle        BillingCycle       @default(monthly)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  trialEndsAt         DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  cancelledAt         DateTime?
  couponId            String?
  discountedPriceKobo Int?
  autoRenew           Boolean            @default(false)

  // Legacy Paystack and billing fields retained during migration
  paystackAuthorizationCode String?
  paystackCustomerCode      String?
  paystackSubscriptionCode  String?
  scheduledDowngradePlanId  String?
  setupFeePaid              Boolean   @default(false)
  setupFeePaidAt            DateTime?
  nextBillingDate           DateTime?
  lastBillingAttemptAt      DateTime?
  failedBillingCount        Int       @default(0)

  // New billing-engine fields
  paymentMethodId  String?
  billingAnchorDay Int     @default(1)
  lapsedPlanId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school         School           @relation(fields: [schoolId], references: [id])
  plan           Plan             @relation(fields: [planId], references: [id])
  coupon         Coupon?          @relation(fields: [couponId], references: [id])
  billingHistory BillingHistory[]

  invoices SubscriptionInvoice[]

  @@index([schoolId, status])
  @@index([planId])
  @@index([currentPeriodEnd])
}

model Coupon {
  id String @id @default(uuid())

  code        String  @unique
  description String?

  discountType  DiscountType
  discountValue Int

  maxUses   Int?
  usedCount Int  @default(0)

  validFrom  DateTime
  validUntil DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model BillingHistory {
  id String @id @default(uuid())

  subscriptionId String

  amountKobo Int
  status     PaymentStatus @default(pending)

  billingCycle      BillingCycle
  paystackReference String?

  paidAt        DateTime?
  failureReason String?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, createdAt])
  @@index([status])
}

// ===== BILLING ENGINE =====

// One invoice per charge.
// Subscription state follows invoice state, never the other way round.
model SubscriptionInvoice {
  id                String               @id @default(uuid())
  number            String               @unique
  idempotencyKey    String?              @unique
  subscriptionId    String
  schoolId          String
  planId            String
  billingCycle      BillingCycle
  reason            BillingInvoiceReason
  status            BillingInvoiceStatus @default(open)
  periodStart       DateTime
  periodEnd         DateTime
  subtotalKobo      Int
  discountKobo      Int                  @default(0)
  totalKobo         Int
  amountPaidKobo    Int                  @default(0)
  couponId          String?
  dueDate           DateTime
  issuedAt          DateTime             @default(now())
  paidAt            DateTime?
  voidedAt          DateTime?
  attemptCount      Int                  @default(0)
  nextAttemptAt     DateTime?
  lastFailureReason String?
  note              String?
  createdById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  school       School       @relation(fields: [schoolId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])

  items    SubscriptionInvoiceItem[]
  attempts PaymentAttempt[]

  @@index([schoolId, createdAt])
  @@index([subscriptionId, status])
  @@index([status, dueDate])
  @@index([status, nextAttemptAt])
}

model SubscriptionInvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String
  kind        BillingItemKind
  description String
  amountKobo  Int
  createdAt   DateTime        @default(now())

  invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PaymentAttempt {
  id              String               @id @default(uuid())
  invoiceId       String
  reference       String               @unique
  amountKobo      Int
  status          PaymentAttemptStatus @default(pending)
  method          PaymentAttemptMethod
  paymentMethodId String?
  providerStatus  String?
  failureReason   String?
  createdAt       DateTime             @default(now())
  completedAt     DateTime?

  invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status, createdAt])
}

// Saved payment methods.
// authorizationCode must be encrypted by the application.
model PaymentMethod {
  id                String    @id @default(uuid())
  schoolId          String
  provider          String    @default("paystack")
  authorizationCode String
  signature         String?
  brand             String?
  last4             String?
  expMonth          Int?
  expYear           Int?
  bank              String?
  checkoutEmail     String
  isDefault         Boolean   @default(true)
  createdAt         DateTime  @default(now())
  removedAt         DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, signature])
  @@index([schoolId, removedAt])
}

// Idempotent provider webhook-event log.
model WebhookEvent {
  id          String             @id @default(uuid())
  provider    String
  eventKey    String
  eventType   String
  reference   String?
  status      WebhookEventStatus @default(received)
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?

  @@unique([provider, eventKey])
  @@index([status, receivedAt])
}

// Prevents duplicate billing reminders.
model BillingNotice {
  subscriptionId String
  periodEnd      DateTime
  key            String
  sentAt         DateTime @default(now())

  @@id([subscriptionId, periodEnd, key])
}

// Invoice-number sequence counters.
model PlatformSequence {
  key       String
  period    String   @default("")
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  @@id([key, period])
}

// ===== PLATFORM RBAC =====

model PlatformRole {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  systemKey   String?          @unique
  kind        PlatformRoleKind
  grantsAll   Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  permissions PlatformRolePermission[]
  members     PlatformMemberRole[]
}

model PlatformRolePermission {
  roleId        String
  permissionKey String

  role       PlatformRole         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PermissionDefinition @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

model PlatformMember {
  id        String       @id @default(uuid())
  userId    String       @unique
  status    MemberStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles PlatformMemberRole[]
}

model PlatformMemberRole {
  memberId     String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  member PlatformMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   PlatformRole   @relation(fields: [roleId], references: [id])

  @@id([memberId, roleId])
  @@index([roleId])
}

model PermissionDefinition {
  key                 String            @id
  realm               PermissionRealm
  module              String
  scopes              PermissionScope[]
  personas            Persona[]
  requiresFeature     String?
  introducedInVersion Int
  label               String
  description         String?
  isSensitive         Boolean           @default(false)
  isDeprecated        Boolean           @default(false)
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  templatePermissions     RoleTemplatePermission[]
  platformRolePermissions PlatformRolePermission[]

  @@index([realm, module])
  @@index([isDeprecated])
}

model RoleTemplate {
  id                String   @id @default(uuid())
  key               String   @unique
  name              String
  description       String?
  persona           Persona  @default(STAFF)
  isLocked          Boolean  @default(false)
  grantsAll         Boolean  @default(false)
  autoProvision     Boolean  @default(true)
  defaultForPersona Persona? @unique
  version           Int      @default(1)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  permissions RoleTemplatePermission[]
}

model RoleTemplatePermission {
  templateId    String
  permissionKey String
  scope         PermissionScope @default(ALL)

  template   RoleTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  permission PermissionDefinition @relation(fields: [permissionKey], references: [key])

  @@id([templateId, permissionKey])
  @@index([permissionKey])
}

// ===== ENTITLEMENTS =====

model FeatureDefinition {
  key           String           @id
  origin        DefinitionOrigin @default(CODE)
  kind          FeatureKind
  module        String
  meterKey      String?
  unit          String?
  name          String
  description   String?
  enforcement   Enforcement      @default(BLOCK)
  upsellMessage String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  planEntitlements PlanEntitlement[]
  overrides        SchoolEntitlementOverride[]

  @@index([module, isActive])
  @@index([kind])
  @@index([origin])
}

model PlanEntitlement {
  planId     String
  featureKey String
  boolValue  Boolean?
  limitValue Int?
  enumValue  String?

  plan    Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature FeatureDefinition @relation(fields: [featureKey], references: [key])

  @@id([planId, featureKey])
  @@index([featureKey])
}

model SchoolEntitlementOverride {
  schoolId    String
  featureKey  String
  boolValue   Boolean?
  limitValue  Int?
  enumValue   String?
  reason      String
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feature FeatureDefinition @relation(fields: [featureKey], references: [key])

  @@id([schoolId, featureKey])
  @@index([featureKey])
  @@index([expiresAt])
  @@index([createdById])
}

// No entitlement row means the feature is not granted.
// A null limitValue on a LIMIT feature represents an unlimited limit.
// QUOTA features can use meterKey for usage tracking.

// ===== PLATFORM SETTINGS DEFINITIONS =====

model SettingDefinition {
  key              String      @id
  area             String
  type             SettingType
  constraints      Json?
  dependsOn        Json?
  requiresFeature  String?
  isSecret         Boolean     @default(false)
  group            String?
  label            String
  description      String?
  defaultValue     Json
  isSchoolEditable Boolean     @default(true)
  sortOrder        Int         @default(0)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([area, isActive])
  @@index([sortOrder])
}

// ===== AUTOMATION DEFINITIONS =====

model AutomationRuleDefinition {
  key              String                @id
  module           String
  trigger          AutomationTrigger
  eventKey         String?
  anchor           String?
  paramsSchema     Json
  allowedChannels  NotificationChannel[]
  allowedAudiences String[]
  templateKey      String
  allowMultiple    Boolean               @default(false)
  requiresFeature  String?
  name             String
  description      String?
  defaultEnabled   Boolean               @default(false)
  defaultParams    Json
  defaultChannels  NotificationChannel[]
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([module, isActive])
  @@index([trigger])
}

// ===== MESSAGE TEMPLATES =====

model MessageTemplate {
  id                  String              @id @default(uuid())
  key                 String
  channel             NotificationChannel
  locale              String              @default("en")
  category            TemplateCategory
  variables           Json
  isSchoolOverridable Boolean             @default(true)
  subject             String?
  body                String
  isActive            Boolean             @default(true)
  version             Int                 @default(1)
  updatedById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([key, channel, locale])
  @@index([category, isActive])
}

// ===== AUDIT LOG =====

model AuditLog {
  id                String    @id @default(uuid())
  userId            String?
  schoolId          String?
  actorMembershipId String?
  actorName         String?
  actorType         ActorType @default(user)
  action            String
  entity            String
  entityId          String?
  module            String?
  requestId         String?
  oldValue          Json?
  newValue          Json?
  ipAddress         String?
  userAgent         String?
  metadata          Json?
  createdAt         DateTime  @default(now())

  school School? @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([module, action])
  @@index([requestId])
  @@index([actorMembershipId])
}

// ===== PLATFORM NOTIFICATIONS =====

model PlatformNotification {
  id               String                   @id @default(uuid())
  title            String
  message          String
  type             PlatformNotificationType
  state            NotificationState        @default(QUEUED)
  createdByAdminId String
  metadata         Json?
  sentAt           DateTime?
  completedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  recipients PlatformNotificationRecipient[]

  @@index([state, createdAt])
  @@index([type])
}

model PlatformNotificationRecipient {
  id             String              @id @default(uuid())
  notificationId String
  schoolId       String
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  retryCount     Int                 @default(0)
  failedReason   String?
  providerMsgId  String?
  idempotencyKey String?             @unique
  queuedAt       DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
  cancelledAt    DateTime?
  nextRetryAt    DateTime?
  readAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  notification PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([notificationId, schoolId, channel])
  @@index([schoolId, status])
  @@index([status, nextRetryAt])
}

// ===== PLATFORM SETTINGS =====

model PlatformSettings {
  // Primary identifier
  id String @id @default(uuid())

  // Platform branding
  platformName   String  @default("SchoolPortal")
  legalName      String?
  shortName      String?
  tagline        String?
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?

  // Support and contact information
  supportEmail    String  @default("support@schoolportal.com")
  supportPhone    String?
  supportWhatsapp String?
  companyAddress  String?

  // Legal pages
  termsUrl         String?
  privacyPolicyUrl String?

  // Email configuration
  emailFromName    String?
  emailFromAddress String?
  emailReplyTo     String?

  // SMS configuration
  smsSenderId String?

  // Website and support links
  marketingSiteUrl String?
  helpCenterUrl    String?
  statusPageUrl    String?
  socialLinks      Json?

  // Default regional settings
  defaultTimezone String @default("Africa/Lagos")
  defaultCountry  String @default("Nigeria")
  defaultCurrency String @default("NGN")
  defaultLocale   String @default("en-NG")

  // Subscription and reminder settings
  subscriptionGracePeriodDays Int @default(7)
  reminderDaysBeforeExpiry    Int @default(7)
  termEndingReminderDays      Int @default(7)
  defaultTrialDays            Int @default(0)

  // Registration and school lifecycle settings
  unconfirmedRegistrationHours  Int @default(72)
  unverifiedSchoolTrialDays     Int @default(30)
  unverifiedSchoolRetentionDays Int @default(60)

  // Platform access and maintenance
  allowNewRegistrations Boolean @default(true)
  maintenanceMode       Boolean @default(false)
  maintenanceMessage    String?
  announcementBanner    String?

  // Audit information
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== FEEDBACK =====

model Feedback {
  id        String         @id @default(uuid())
  userId    String?
  schoolId  String?
  type      FeedbackType   @default(suggestion)
  message   String
  pageUrl   String?
  status    FeedbackStatus @default(open)
  response  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  school School? @relation(fields: [schoolId], references: [id])

  @@index([userId, createdAt])
  @@index([schoolId, createdAt])
  @@index([status])
}
