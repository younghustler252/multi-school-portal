// NOTE: this schema exists ONLY to drive `prisma migrate dev`/`migrate diff`
// for the public "migrations/" folder going forward. The app's actual
// Prisma Client still comes from the merged prisma/schema.prisma (via
// merge.ts) — do not import anything from this generator's output.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/public"
}

datasource db {
  provider = "postgresql"
}

// ===== SCHOOL =====
model School {
  id                     String             @id @default(uuid())
  name                   String
  subdomain              String             @unique
  customDomain           String?
  customDomainVerifiedAt DateTime?
  email                  String             @unique
  phone                  String?
  address                String?
  city                   String?
  state                  String?
  country                String             @default("Nigeria")
  timezone               String             @default("Africa/Lagos")
  logoUrl                String?
  schoolCategory         SchoolCategory     @default(primary)
  schoolOwnership        SchoolOwnership    @default(private)
  status                 SchoolStatus       @default(pending)
  verificationStatus     VerificationStatus @default(unverified)
  verifiedAt             DateTime?
  verifiedById           String?
  suspendedAt            DateTime?
  suspensionReason       String?
  isActive               Boolean            @default(false)

  schemaName          String?   @unique
  schemaProvisionedAt DateTime?

  paystackSubaccountCode  String?
  paystackSubaccountId    String?
  settlementBankCode      String?
  settlementAccountNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                          User[]
  subscriptions                  Subscription[]
  documents                      SchoolDocument[]
  auditLogs                      AuditLog[]
  platformNotificationRecipients PlatformNotificationRecipient[]
}

enum SchoolCategory {
  primary
  secondary
  primary_secondary
}

enum SchoolOwnership {
  private
  public
  mission
  international
}

enum SchoolStatus {
  pending
  active
  suspended
  deactivated
}

enum VerificationStatus {
  unverified
  under_review
  verified
  rejected
}

model SchoolDocument {
  id              String         @id @default(uuid())
  schoolId        String
  type            DocumentType
  fileUrl         String
  status          DocumentStatus @default(pending)
  rejectionReason String?
  verifiedAt      DateTime?
  verifiedById    String?
  apiVerified     Boolean        @default(false)
  apiResponse     Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  school          School         @relation(fields: [schoolId], references: [id])
}

enum DocumentType {
  cac_certificate
  proprietor_id
  waec_approval
  ministry_approval
  other
}

enum DocumentStatus {
  pending
  under_review
  approved
  rejected
}

// =====================
// AUTH / IDENTITY MODULE
// =====================

model User {
  id String @id @default(uuid())

  schoolId String?

  email        String @unique
  passwordHash String

  role Role

  firstName String?
  lastName  String?
  phone     String?
  photoUrl  String?

  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?

  lastLoginAt        DateTime?
  lastLoginIp        String?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  mustChangePassword Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School?        @relation(fields: [schoolId], references: [id])
  refreshTokens RefreshToken[]
  otps          Otp[]
  invitesSent   Invite[]       @relation("InviteSender")
}

model Otp {
  id String @id @default(uuid())

  userId String
  code   String
  type   OtpType

  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id String @id @default(uuid())

  userId String
  token  String @unique

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invite {
  id String @id @default(uuid())

  email String
  role  Role

  token    String @unique
  schoolId String

  sentById String

  accepted  Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())

  sentBy User @relation("InviteSender", fields: [sentById], references: [id])
}

enum Role {
  super_admin
  school_admin
  principal
  teacher
  bursar
  student
  guardian
}

enum OtpType {
  email_verification
  password_reset
  two_factor
}

// =====================
// BILLING / SUBSCRIPTION MODULE
// =====================
model Plan {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  studentLimit Int
  staffLimit   Int
  features     Json @default("{}")

  monthlyPriceKobo Int @default(0)
  yearlyPriceKobo  Int @default(0)
  setupFeeKobo     Int @default(0)

  isPublic Boolean @default(true)
  isActive Boolean @default(true)
  isCustom Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                       String             @id @default(uuid())
  schoolId                 String
  planId                   String
  status                   SubscriptionStatus @default(active)
  billingCycle             BillingCycle       @default(monthly)
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  trialEndsAt              DateTime?
  cancelAtPeriodEnd        Boolean            @default(false)
  cancelledAt              DateTime?
  couponId                 String?
  discountedPriceKobo      Int?
  setupFeePaid             Boolean            @default(false)
  setupFeePaidAt           DateTime?
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  nextBillingDate          DateTime?
  lastBillingAttemptAt     DateTime?
  failedBillingCount       Int                @default(0)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  school                   School             @relation(fields: [schoolId], references: [id])
  plan                     Plan               @relation(fields: [planId], references: [id])
  coupon                   Coupon?            @relation(fields: [couponId], references: [id])
  billingHistory           BillingHistory[]
}

model Coupon {
  id String @id @default(uuid())

  code        String  @unique
  description String?

  discountType  DiscountType
  discountValue Int

  maxUses   Int?
  usedCount Int  @default(0)

  validFrom  DateTime
  validUntil DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model BillingHistory {
  id String @id @default(uuid())

  subscriptionId String

  amountKobo Int
  status     PaymentStatus @default(pending)

  billingCycle BillingCycle

  paystackReference String?

  paidAt        DateTime?
  failureReason String?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
  expired
}

enum BillingCycle {
  monthly
  yearly
}

enum DiscountType {
  percentage
  fixed_amount
}

// Public-schema copy of PaymentStatus — used only for BillingHistory (platform billing).
// This is a distinct type from the tenant schema's PaymentStatus (fee payments),
// even though the values happen to match today. Keep them independently editable.
enum PaymentStatus {
  pending
  success
  failed
  refunded
}

// ===== AUDIT LOG =====

model AuditLog {
  id        String    @id @default(uuid())
  userId    String?
  schoolId  String?
  actorType ActorType @default(user)
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime  @default(now())
  school    School?   @relation(fields: [schoolId], references: [id])
}

enum ActorType {
  user
  system
  super_admin
  webhook
}

model PlatformNotification {
  id               String                          @id @default(uuid())
  title            String
  message          String
  type             PlatformNotificationType
  state            NotificationState               @default(QUEUED)
  createdByAdminId String
  metadata         Json?
  sentAt           DateTime?
  completedAt      DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  recipients       PlatformNotificationRecipient[]

  @@index([state, createdAt])
  @@index([type])
}

model PlatformNotificationRecipient {
  id             String              @id @default(uuid())
  notificationId String
  schoolId       String
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  retryCount     Int                 @default(0)
  failedReason   String?
  readAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  notification PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([notificationId, schoolId, channel])
  @@index([schoolId, status])
}

enum PlatformNotificationType {
  welcome
  feature_announcement
  subscription_expiry
  subscription_renewed
  subscription_failed
  account_suspended
  account_verified
  account_rejected
  system_alert
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationState {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}
