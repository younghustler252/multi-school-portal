{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "srcV2",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["srcV2/**/*"],
  "exclude": ["node_modules", "dist"]
}
