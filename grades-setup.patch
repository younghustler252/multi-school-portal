diff --git a/tests/grades/grades-setup.db.test.ts b/tests/grades/grades-setup.db.test.ts
new file mode 100644
index 0000000..16c0b96
--- /dev/null
+++ b/tests/grades/grades-setup.db.test.ts
@@ -0,0 +1,92 @@
+/*
+| GRADES SETUP against a real database (a throwaway school with every tenant migration applied).
+| Runs only when TEST_DATABASE_URL is set (the database name must contain "test"). Tests share one school and run in order.
+*/
+import { describe, it, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { createTestSchool, dbTestsEnabled, skipReason, TestSchool } from "../helpers/test-database";
+import { GradesSetupRepository } from "../../src/modules/grades/repositories/grades-setup.repository";
+import * as U from "../../src/modules/grades/usecases/grades-setup.usecases";
+import { gradeFor } from "../../src/modules/grades/domain/grades.policy";
+
+describe("grades setup (real database)", { skip: dbTestsEnabled ? false : skipReason }, () => {
+    let school: TestSchool; const audits: any[] = [];
+    const actor = { userId: "user-admin" };
+    const deps = () => ({ gradesSetupRepository: new GradesSetupRepository(), auditService: { log: async (p: any) => { audits.push(p); } } } as any);
+    const db = () => (require("../../src/infrastructure/database/prisma/prisma.client") as any).getTenantClient();
+    const jss = [
+        { minScore: 70, grade: "A", remark: "Distinction", isPass: true }, { minScore: 50, grade: "B", remark: "Credit", isPass: true },
+        { minScore: 40, grade: "C", remark: "Pass", isPass: true },        { minScore: 0, grade: "F", remark: "Fail", isPass: false },
+    ];
+    const level = (r: any, l: string) => r.levels.find((x: any) => x.level === l);
+
+    before(async () => { school = await createTestSchool(); });
+    after(async () => { await school.drop(); });
+
+    it("a new school already has the standard scale and the CA 40 + Exam 60 scheme, and every level uses them", () => school.run(async () => {
+        const scales = await new U.ListScalesUseCase(deps()).execute();
+        assert.deepEqual(scales.levels.map((l: any) => [l.level, l.usesDefault]), [["default", false], ["primary", true], ["jss", true], ["ss", true]]);
+        const bands = level(scales, "default").scale.bands;
+        assert.deepEqual(bands.map((b: any) => b.grade), ["A1", "B2", "B3", "C4", "C5", "C6", "D7", "E8", "F9"]);
+        assert.deepEqual([bands[0].upTo, bands[1].upTo, bands[8].minScore, bands[8].isPass], [null, 75, 0, false]);
+        const schemes = await new U.ListSchemesUseCase(deps()).execute();
+        assert.deepEqual(level(schemes, "default").scheme.components.map((c: any) => [c.name, c.kind, c.maxScore]), [["CA", "ca", 40], ["Exam", "exam", 60]]);
+        assert.equal(level(schemes, "ss").scheme.total, 100);
+    }));
+
+    it("74.5 gets a real grade from the stored scale (the old bands made it F9)", () => school.run(async () => {
+        const bands = (await new GradesSetupRepository().scales()).find((s: any) => s.level === null)!.bands;
+        assert.equal(gradeFor(bands, 74.5)!.grade, "B2");
+    }));
+
+    it("saves a JSS scale; other levels still use the default; the change is audited old to new", () => school.run(async () => {
+        const r = await new U.SaveScaleUseCase(deps()).execute(school.schoolId, "jss", { bands: jss } as any, actor);
+        assert.equal(level(r, "jss").usesDefault, false);
+        assert.deepEqual(level(r, "jss").scale.bands.map((b: any) => b.grade), ["A", "B", "C", "F"]);
+        assert.equal(level(r, "ss").usesDefault, true);
+        const a = audits.find(x => x.action === "grades.scale_updated");
+        assert.equal(a.oldValue.bands, null); assert.deepEqual(a.newValue.bands, ["A from 70", "B from 50", "C from 40", "F from 0 (fail)"]);
+    }));
+
+    it("an invalid scale is refused with the reasons, and nothing changes", () => school.run(async () => {
+        const bad = jss.filter(b => b.minScore !== 0);
+        await assert.rejects(() => new U.SaveScaleUseCase(deps()).execute(school.schoolId, "jss", { bands: bad } as any, actor), (e: any) => e.code === "GRADES_SCALE_INVALID" && /start at 0/.test(JSON.stringify(e.details)));
+        assert.equal((await new GradesSetupRepository().scales()).find((s: any) => s.level === "jss")!.bands.length, 4);
+        await assert.rejects(() => new U.SaveScaleUseCase(deps()).execute(school.schoolId, "primary-x", { bands: jss } as any, actor), (e: any) => e.code === "GRADES_LEVEL_INVALID");
+    }));
+
+    it("replacing a scale is all-or-nothing: if saving fails part-way the old scale is still there", () => school.run(async () => {
+        const repo = new GradesSetupRepository();
+        const broken = [{ minScore: 0, grade: "X", remark: "", isPass: false }, { minScore: 0, grade: "Y", remark: "", isPass: true }];   // skips validation on purpose: same start twice
+        await assert.rejects(() => repo.saveScale("jss", broken as any));
+        assert.deepEqual((await repo.scales()).find(s => s.level === "jss")!.bands.map(b => b.grade).sort(), ["A", "B", "C", "F"]);
+    }));
+
+    it("removing a level's scale falls back to the default; the default cannot be removed", () => school.run(async () => {
+        const r = await new U.DeleteScaleUseCase(deps()).execute(school.schoolId, "jss", actor);
+        assert.equal(level(r, "jss").usesDefault, true);
+        await assert.rejects(() => new U.DeleteScaleUseCase(deps()).execute(school.schoolId, "default", actor), (e: any) => e.code === "GRADES_DEFAULT_REQUIRED");
+        await assert.rejects(() => new U.DeleteScaleUseCase(deps()).execute(school.schoolId, "jss", actor), (e: any) => e.statusCode === 404);
+    }));
+
+    it("schemes: CA1 10 + CA2 10 + Assignment 20 + Exam 60 for primary; parts must add up to 100", () => school.run(async () => {
+        const four = [{ name: "CA1", kind: "ca", maxScore: 10 }, { name: "CA2", kind: "ca", maxScore: 10 }, { name: "Assignment", kind: "ca", maxScore: 20 }, { name: "Exam", kind: "exam", maxScore: 60 }];
+        const r = await new U.SaveSchemeUseCase(deps()).execute(school.schoolId, "primary", { components: four } as any, actor);
+        assert.deepEqual(level(r, "primary").scheme.components.map((c: any) => c.name), ["CA1", "CA2", "Assignment", "Exam"]);
+        assert.equal(level(r, "primary").scheme.total, 100); assert.equal(level(r, "jss").usesDefault, true);
+        await assert.rejects(() => new U.SaveSchemeUseCase(deps()).execute(school.schoolId, "primary", { components: four.slice(0, 3) } as any, actor), (e: any) => e.code === "GRADES_SCHEME_INVALID");
+        assert.equal(level(await new U.ListSchemesUseCase(deps()).execute(), "primary").scheme.components.length, 4, "unchanged");
+        assert.deepEqual(audits.filter(x => x.action === "grades.scheme_updated").pop().newValue.parts, ["CA1 10 (ca)", "CA2 10 (ca)", "Assignment 20 (ca)", "Exam 60 (exam)"]);
+        const gone = await new U.DeleteSchemeUseCase(deps()).execute(school.schoolId, "primary", actor);
+        assert.equal(level(gone, "primary").usesDefault, true);
+        await assert.rejects(() => new U.DeleteSchemeUseCase(deps()).execute(school.schoolId, "default", actor), (e: any) => e.code === "GRADES_DEFAULT_REQUIRED");
+    }));
+
+    it("the database itself refuses a second default, a band at 100 or more, and a part with no size", () => school.run(async () => {
+        await assert.rejects(() => db().gradingScale.create({ data: { name: "Second default", level: null } }), /unique|Unique/);
+        const scale = await db().gradingScale.create({ data: { name: "T", level: "ss" } });
+        await assert.rejects(() => db().gradingBand.create({ data: { scaleId: scale.id, minScore: 100, grade: "A", remark: "" } }), /check|constraint/i);
+        const scheme = await db().assessmentScheme.create({ data: { name: "T", level: "ss" } });
+        await assert.rejects(() => db().assessmentComponent.create({ data: { schemeId: scheme.id, name: "Zero", kind: "ca", maxScore: 0, position: 1 } }), /check|constraint/i);
+    }));
+});
diff --git a/tests/grades/grades.policy.test.ts b/tests/grades/grades.policy.test.ts
new file mode 100644
index 0000000..9470de7
--- /dev/null
+++ b/tests/grades/grades.policy.test.ts
@@ -0,0 +1,84 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { levelOfClass, validateBands, gradeFor, validateComponents, isLevelKey } from "../../src/modules/grades/domain/grades.policy";
+import { SaveScaleDto, SaveSchemeDto } from "../../src/modules/grades/dtos/grades-setup.dto";
+import { validatePermissionRegistry, PERMISSION_REGISTRY } from "../../src/foundation/permissions.registry";
+import { ROLE_TEMPLATES } from "../../src/foundation/role-templates.registry";
+
+const waec = [
+    { minScore: 75, grade: "A1", remark: "Excellent", isPass: true }, { minScore: 70, grade: "B2", remark: "Very Good", isPass: true },
+    { minScore: 65, grade: "B3", remark: "Good", isPass: true },      { minScore: 60, grade: "C4", remark: "Credit", isPass: true },
+    { minScore: 55, grade: "C5", remark: "Credit", isPass: true },    { minScore: 50, grade: "C6", remark: "Credit", isPass: true },
+    { minScore: 45, grade: "D7", remark: "Pass", isPass: true },      { minScore: 40, grade: "E8", remark: "Pass", isPass: true },
+    { minScore: 0,  grade: "F9", remark: "Fail", isPass: false },
+];
+
+describe("which grading level a class is in", () => {
+    it("recognises primary, JSS and SS names; anything else uses the default", () => {
+        for (const v of ["Primary 3", "Nursery 2", "Basic 5", "KG1"]) assert.equal(levelOfClass(v), "primary", v);
+        for (const v of ["JSS", "jss 2", "Junior Secondary"]) assert.equal(levelOfClass(v), "jss", v);
+        for (const v of ["SSS", "SS 3", "Senior Secondary"]) assert.equal(levelOfClass(v), "ss", v);
+        for (const v of [null, undefined, "", "  ", "Gold class"]) assert.equal(levelOfClass(v as any), null, String(v));
+    });
+    it("level keys: default, primary, jss, ss only", () => {
+        assert.deepEqual(["default", "primary", "jss", "ss", "SS", "x"].map(isLevelKey), [true, true, true, true, false, false]);
+    });
+});
+
+describe("grade for a total (no gaps between bands)", () => {
+    it("74.5 is B2, not a 'fail' (the old inclusive min/max bands lost it)", () => {
+        assert.equal(gradeFor(waec, 74.5)!.grade, "B2");
+        assert.equal(gradeFor(waec, 74.99)!.grade, "B2");
+    });
+    it("edges: exactly on a start, the top, the bottom, and out of range", () => {
+        assert.deepEqual([75, 100, 70, 40, 39.99, 0, 120, -1].map(t => gradeFor(waec, t)!.grade), ["A1", "A1", "B2", "E8", "F9", "F9", "A1", "F9"]);
+    });
+});
+
+describe("a valid scale", () => {
+    it("the standard scale is valid", () => assert.deepEqual(validateBands(waec), []));
+    it("a short school scale is valid", () => assert.deepEqual(validateBands([{ minScore: 50, grade: "Pass", remark: "", isPass: true }, { minScore: 0, grade: "Fail", remark: "", isPass: false }]), []));
+    it("says what is wrong, in plain words", () => {
+        const t = (b: any[]) => validateBands(b).join(" | ");
+        assert.match(t(waec.filter(b => b.minScore !== 0)), /must start at 0/);
+        assert.match(t([...waec, { minScore: 70, grade: "X", remark: "", isPass: true }]), /Two bands start at 70/);
+        assert.match(t([...waec, { minScore: 10, grade: "a1", remark: "", isPass: false }]), /used twice/);
+        assert.match(t(waec.map(b => ({ ...b, isPass: false }))), /at least one band must be a pass/i);
+        assert.match(t(waec.map(b => b.grade === "C5" ? { ...b, isPass: false } : b)), /fail but sits above a pass/);
+        assert.match(t([{ minScore: 100, grade: "A", remark: "", isPass: true }, { minScore: 0, grade: "F", remark: "", isPass: false }]), /below 100/);
+        assert.match(t([]), /between 1 and 15/);
+    });
+});
+
+describe("a valid assessment scheme", () => {
+    const c = (name: string, kind: "ca" | "exam", maxScore: number) => ({ name, kind, maxScore });
+    it("parts must add up to 100", () => {
+        assert.deepEqual(validateComponents([c("CA", "ca", 40), c("Exam", "exam", 60)]), []);
+        assert.deepEqual(validateComponents([c("CA1", "ca", 10), c("CA2", "ca", 10), c("Assignment", "ca", 20), c("Exam", "exam", 60)]), []);
+        assert.deepEqual(validateComponents([c("A", "ca", 33.33), c("B", "exam", 66.67)]), []);
+        assert.match(validateComponents([c("CA", "ca", 40), c("Exam", "exam", 50)]).join(), /add up to 90, but must add up to 100/);
+        assert.match(validateComponents([c("CA", "ca", 50), c("Exam", "exam", 60)]).join(), /add up to 110/);
+    });
+    it("names are unique, maximums are above 0, and there are at most 8 parts", () => {
+        assert.match(validateComponents([c("CA", "ca", 40), c("ca", "exam", 60)]).join(), /used twice/);
+        assert.match(validateComponents([c("CA", "ca", 0), c("Exam", "exam", 100)]).join(), /above 0/);
+        assert.match(validateComponents(Array.from({ length: 9 }, (_, i) => c("P" + i, "ca", 100 / 9))).join(), /between 1 and 8/);
+    });
+});
+
+describe("requests and permissions", () => {
+    it("unknown fields and bad shapes are refused", () => {
+        assert.equal(SaveScaleDto.safeParse({ bands: waec }).success, true);
+        assert.equal(SaveScaleDto.safeParse({ bands: waec, level: "jss" }).success, false);
+        assert.equal(SaveScaleDto.safeParse({ bands: [{ minScore: "70", grade: "A", remark: "", isPass: true }] }).success, false);
+        assert.equal(SaveSchemeDto.safeParse({ components: [{ name: "CA", kind: "quiz", maxScore: 40 }] }).success, false);
+        assert.equal(SaveSchemeDto.safeParse({ components: [{ name: "CA", kind: "ca", maxScore: 100 }] }).success, true);
+    });
+    it("grades.view and grades.config are registered; only the admin changes the setup", () => {
+        assert.deepEqual(validatePermissionRegistry(PERMISSION_REGISTRY), []);
+        assert.deepEqual(PERMISSION_REGISTRY.filter(p => p.module === "grades").map(p => p.key).sort(), ["grades.config", "grades.view"]);
+        const has = (role: string, scope: string) => ROLE_TEMPLATES.find(t => t.key === role)!.permissions.some(p => p.key === "grades.view" && p.scope === scope);
+        assert.deepEqual([has("principal", "ALL"), has("teacher", "ASSIGNED"), has("student", "OWN"), has("guardian", "OWN")], [true, true, true, true]);
+        assert.equal(ROLE_TEMPLATES.some(t => t.key !== "school_admin" && t.permissions.some(p => p.key === "grades.config")), false);
+    });
+});
diff --git a/tests/grades/migration.db.test.ts b/tests/grades/migration.db.test.ts
new file mode 100644
index 0000000..9d0ffea
--- /dev/null
+++ b/tests/grades/migration.db.test.ts
@@ -0,0 +1,52 @@
+/*
+| The grades setup migration on schools that ALREADY have a grading list: every earlier migration applied, an old list saved,
+| then ONLY the new migration. A usable list is copied across; an unusable or empty one is replaced by the standard scale.
+| Runs only when TEST_DATABASE_URL is set (database name must contain "test").
+*/
+import { describe, it, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { Pool } from "pg";
+import { readdirSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import { randomBytes } from "node:crypto";
+import { dbTestsEnabled, skipReason, testDatabaseUrl } from "../helpers/test-database";
+
+const NEW = "20261103090000_grades_setup";
+type Old = [number, number, string, string];
+
+describe("grades setup migration on populated schools", { skip: dbTestsEnabled ? false : skipReason }, () => {
+    const tag = randomBytes(3).toString("hex"); const schemas: string[] = [];
+    let pool: Pool; let c: any;
+    const dir = join(process.cwd(), "prisma", "tenant-migrations");
+    const all = readdirSync(dir, { withFileTypes: true }).filter(e => e.isDirectory()).map(e => e.name).sort();
+    const sql = (m: string) => readFileSync(join(dir, m, "migration.sql"), "utf8");
+
+    async function migrated(name: string, old: Old[]) {
+        const schema = `test_gs_${name}_${tag}`; schemas.push(schema);
+        await c.query(`CREATE SCHEMA "${schema}"`); await c.query(`SET search_path TO "${schema}"`);
+        for (const m of all.filter(m => m < NEW)) await c.query(sql(m));
+        for (const [min, max, g, r] of old) await c.query(`INSERT INTO "GradingConfig"(id,"minScore","maxScore",grade,remark,"updatedAt") VALUES (gen_random_uuid()::text,$1,$2,$3,$4,now())`, [min, max, g, r]);
+        await c.query(sql(NEW));
+        const bands = (await c.query(`SELECT grade, "minScore" m, "isPass" p FROM "GradingBand" ORDER BY "minScore" DESC`)).rows;
+        const parts = (await c.query(`SELECT name, kind::text k, "maxScore" m FROM "AssessmentComponent" ORDER BY position`)).rows;
+        return { bands, parts };
+    }
+    before(async () => { pool = new Pool({ connectionString: testDatabaseUrl, max: 1 }); c = await pool.connect(); });
+    after(async () => { c.release(); const p = new Pool({ connectionString: testDatabaseUrl, max: 1 }); for (const s of schemas) await p.query(`DROP SCHEMA IF EXISTS "${s}" CASCADE`); await p.end(); await pool.end(); });
+
+    it("a new school (empty old list) gets the standard A1 to F9 scale and CA 40 + Exam 60", async () => {
+        const r = await migrated("new", []);
+        assert.deepEqual(r.bands.map((b: any) => b.grade), ["A1", "B2", "B3", "C4", "C5", "C6", "D7", "E8", "F9"]);
+        assert.deepEqual(r.parts, [{ name: "CA", k: "ca", m: 40 }, { name: "Exam", k: "exam", m: 60 }]);
+    });
+    it("a usable old list is copied across, with pass from 40 up", async () => {
+        const r = await migrated("ok", [[80, 100, "A", "Distinction"], [60, 79, "B", "Good"], [40, 59, "C", "Pass"], [0, 39, "F", "Fail"]]);
+        assert.deepEqual(r.bands.map((b: any) => [b.grade, b.m, b.p]), [["A", 80, true], ["B", 60, true], ["C", 40, true], ["F", 0, false]]);
+    });
+    it("an unusable old list (does not start at 0, or repeats a start) is replaced by the standard scale, never guessed", async () => {
+        const noZero = await migrated("nozero", [[30, 100, "A", "Top"], [10, 29, "B", "Low"]]);
+        assert.equal(noZero.bands.length, 9); assert.equal(noZero.bands[0].grade, "A1");
+        const dup = await migrated("dup", [[0, 50, "F", "Fail"], [0, 9, "G", "Dup"], [50, 100, "P", "Pass"]]);
+        assert.equal(dup.bands.length, 9);
+    });
+});
