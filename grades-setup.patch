+        saveSchemeUseCase:     asClass(SaveSchemeUseCase).scoped(),
+        deleteSchemeUseCase:   asClass(DeleteSchemeUseCase).scoped(),
+        gradesSetupController: asClass(GradesSetupController).scoped(),
+    });
+};
