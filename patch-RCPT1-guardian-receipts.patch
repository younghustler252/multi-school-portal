diff --git a/apps/api/src/modules/payments/services/family-payment-visibility.ts b/apps/api/src/modules/payments/services/family-payment-visibility.ts
new file mode 100644
index 0000000..fceac26
--- /dev/null
+++ b/apps/api/src/modules/payments/services/family-payment-visibility.ts
@@ -0,0 +1,71 @@
+import { ReceiptSnapshot } from "../domain/payment.entity";
+
+/*
+|--------------------------------------------------------------------------
+| WHAT A GUARDIAN MAY SEE OF A PAYMENT AND ITS RECEIPT
+|--------------------------------------------------------------------------
+| A payment can cover several students (one transfer for two children, a cash payment spread over a family). A guardian
+| may see:
+|   - a payment they MADE (they are the payer), and
+|   - a confirmed payment that covers one of THEIR linked children, even if somebody else made it.
+|
+| But never another child's details:
+|   - lines and credit for THEIR children show in full (invoice number, student name, amount, balance after).
+|   - lines and credit for OTHER children:
+|       * the payer sees them as ONE anonymous amount ("other students"), so the total still adds up: no names,
+|         invoice numbers or balances.
+|       * a guardian who is not the payer does not see them at all, and sees only their own children's share as the
+|         amount (partial = true).
+|   - the payer's phone number and the payment's reference are shown to the payer only.
+| Anything that fails these rules is "not found" (never "forbidden"), so nothing about it is confirmed.
+|--------------------------------------------------------------------------
+*/
+
+export interface FamilyReceipt {
+    receiptNumber: string; issuedAt: string; paidOn: string; status: string;
+    school: ReceiptSnapshot["school"];
+    payer: { type: ReceiptSnapshot["payer"]["type"]; name: string | null; phone: string | null };
+    method: ReceiptSnapshot["method"]; reference: string | null;
+    /** Payer: what they paid in all. Anyone else: the share that covers their own children. Kobo, as digits. */
+    amountKobo: string;
+    /** True when amountKobo is only the share for the viewer's children (the viewer did not make the payment). */
+    partial: boolean;
+    lines: ReceiptSnapshot["lines"];
+    credit: ReceiptSnapshot["credit"];
+    /** Payer only: the part that covers students who are not the viewer's children, with nothing that identifies them. */
+    otherStudents: { amountKobo: string } | null;
+}
+
+const big = (s: string): bigint => { try { return BigInt(s); } catch { return 0n; } };
+
+/** The receipt as this guardian may see it, or null when they may not see it at all. */
+export function receiptForGuardian(snapshot: ReceiptSnapshot, v: { isPayer: boolean; childIds: ReadonlySet<string>; status: string }): FamilyReceipt | null {
+    const mine = (studentId: string) => v.childIds.has(studentId);
+
+    const myLines = snapshot.lines.filter(l => mine(l.studentId));
+    const otherLines = snapshot.lines.filter(l => !mine(l.studentId));
+    const myCredit = snapshot.credit && mine(snapshot.credit.studentId) ? snapshot.credit : null;
+    const otherCredit = snapshot.credit && !mine(snapshot.credit.studentId) ? snapshot.credit : null;
+
+    const coversMyChild = myLines.length > 0 || myCredit !== null;
+    if (!v.isPayer && !coversMyChild) return null;
+
+    const myShare = myLines.reduce((s, l) => s + big(l.amountKobo), 0n) + (myCredit ? big(myCredit.amountKobo) : 0n);
+    const othersShare = otherLines.reduce((s, l) => s + big(l.amountKobo), 0n) + (otherCredit ? big(otherCredit.amountKobo) : 0n);
+
+    return {
+        receiptNumber: snapshot.receiptNumber, issuedAt: snapshot.issuedAt, paidOn: snapshot.paidOn, status: v.status,
+        school: snapshot.school,
+        payer: { type: snapshot.payer.type, name: snapshot.payer.name, phone: v.isPayer ? snapshot.payer.phone : null },
+        method: snapshot.method, reference: v.isPayer ? snapshot.reference : null,
+        amountKobo: v.isPayer ? snapshot.amountKobo : myShare.toString(),
+        partial: !v.isPayer,
+        lines: myLines, credit: myCredit,
+        otherStudents: v.isPayer && othersShare > 0n ? { amountKobo: othersShare.toString() } : null,
+    };
+}
+
+/** The kobo of a payment that went to the given students (credit included), whatever its state. */
+export function shareForStudents(allocations: { studentId: string; amountKobo: bigint }[], childIds: ReadonlySet<string>): bigint {
+    return allocations.filter(a => childIds.has(a.studentId)).reduce((s, a) => s + a.amountKobo, 0n);
+}
diff --git a/apps/api/src/modules/payments/services/family-payments.where.ts b/apps/api/src/modules/payments/services/family-payments.where.ts
new file mode 100644
index 0000000..7d0250a
--- /dev/null
+++ b/apps/api/src/modules/payments/services/family-payments.where.ts
@@ -0,0 +1,29 @@
+import { PaymentFilters } from "../domain/payment.entity";
+
+/*
+| WHICH PAYMENTS A GUARDIAN'S OWN LIST CONTAINS
+|   - every payment they made themselves (any state: they may be waiting for a transfer to be confirmed), and
+|   - payments somebody ELSE made that cover one of their linked children, but only once money really moved
+|     (CONFIRMED, or REVERSED afterwards). Another person's pending or failed attempts are never shown.
+| Filters narrow this list; they never widen it. A student filter for a child who is not theirs matches nothing.
+| The payer and branch filters of the staff list are not available here.
+*/
+const MONEY_MOVED = ["CONFIRMED", "REVERSED"];
+
+export function familyPaymentsWhere(guardianId: string, linkedStudentIds: string[], f: PaymentFilters): Record<string, unknown> {
+    if (f.studentId && !linkedStudentIds.includes(f.studentId)) return { id: { in: [] } };   // not their child: nothing
+
+    const forMyChildren = f.studentId ? [f.studentId] : linkedStudentIds;
+    const reach: Record<string, unknown>[] = [{ guardianId }];
+    if (forMyChildren.length > 0) reach.push({ status: { in: MONEY_MOVED }, allocations: { some: { studentId: { in: forMyChildren } } } });
+
+    return {
+        AND: [
+            { OR: reach },
+            ...(f.studentId ? [{ allocations: { some: { studentId: f.studentId } } }] : []),
+            ...(f.status ? [{ status: f.status }] : []),
+            ...(f.method ? [{ method: f.method }] : []),
+            ...((f.from || f.to) ? [{ paidAt: { ...(f.from && { gte: f.from }), ...(f.to && { lte: f.to }) } }] : []),
+        ],
+    };
+}
diff --git a/apps/api/src/modules/payments/usecases/family-payments.usecases.ts b/apps/api/src/modules/payments/usecases/family-payments.usecases.ts
new file mode 100644
index 0000000..9a47e7e
--- /dev/null
+++ b/apps/api/src/modules/payments/usecases/family-payments.usecases.ts
@@ -0,0 +1,42 @@
+import { IPaymentRepository } from "../repositories/payment.repository";
+import { IPaymentContextRepository } from "../repositories/payment-context.repository";
+import { PaymentMapper } from "../mappers/payment.mapper";
+import { parseDay } from "../../ledger/domain/ledger.dates";
+import { paymentErrors } from "../domain/payment.errors";
+import { receiptForGuardian } from "../services/family-payment-visibility";
+import { ListPaymentsQueryType } from "../dtos/payment.dto";
+
+interface Dependencies { paymentRepository: IPaymentRepository; paymentContextRepository: IPaymentContextRepository; paymentMapper: PaymentMapper }
+
+/* A GUARDIAN'S OWN PAYMENTS: what they paid, plus confirmed payments by others that cover their linked children (their share only). */
+export class ListMyPaymentsUseCase {
+    constructor(private readonly d: Dependencies) {}
+
+    async execute(guardianId: string, q: ListPaymentsQueryType) {
+        const { page, limit, from, to, status, method, studentId } = q;          // the staff-only filters (payer, branch) are ignored here
+        const linked = await this.d.paymentContextRepository.guardianLinkedStudentIds(guardianId);
+        const childIds = new Set(linked);
+        const r = await this.d.paymentRepository.listForFamily(guardianId, linked,
+            { ...(status && { status }), ...(method && { method }), ...(studentId && { studentId }), ...(from && { from: parseDay(from) }), ...(to && { to: parseDay(to) }) }, page, limit);
+        return { data: r.data.map(p => this.d.paymentMapper.toFamilySummary(p, guardianId, childIds)), meta: r.meta };
+    }
+}
+
+/*
+| A GUARDIAN'S RECEIPT: the frozen receipt, cut down to what they may see (see family-payment-visibility).
+| A payment that is not theirs, covers none of their children, or has no receipt yet all look the same: "receipt not found".
+*/
+export class GetMyReceiptUseCase {
+    constructor(private readonly d: Dependencies) {}
+
+    async execute(paymentId: string, guardianId: string) {
+        const payment = await this.d.paymentRepository.findById(paymentId);
+        const receipt = payment ? await this.d.paymentRepository.findReceipt(paymentId) : null;
+        if (!payment || !receipt) throw paymentErrors.receiptNotFound();
+
+        const childIds = new Set(await this.d.paymentContextRepository.guardianLinkedStudentIds(guardianId));
+        const view = receiptForGuardian(receipt.snapshot, { isPayer: payment.guardianId === guardianId, childIds, status: payment.status });
+        if (!view) throw paymentErrors.receiptNotFound();
+        return { id: receipt.id, paymentId, ...view };
+    }
+}
diff --git a/apps/api/tests/finance/family-payment-visibility.test.ts b/apps/api/tests/finance/family-payment-visibility.test.ts
new file mode 100644
index 0000000..5416669
--- /dev/null
+++ b/apps/api/tests/finance/family-payment-visibility.test.ts
@@ -0,0 +1,45 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { receiptForGuardian, shareForStudents } from "../../src/modules/payments/services/family-payment-visibility";
+
+const base = (over: any = {}): any => ({
+    receiptNumber: "R1", issuedAt: "2026-02-10T09:00:00.000Z", paidOn: "2026-02-10",
+    school: { name: "S", address: null, logoUrl: null, principalName: null },
+    payer: { type: "GUARDIAN", name: "Payer", phone: "0800" }, method: "cash", reference: "REF", amountKobo: "150",
+    lines: [{ invoiceNumber: "I1", studentId: "mine", studentName: "Mine", amountKobo: "100", balanceAfterKobo: "0" }, { invoiceNumber: "I2", studentId: "other", studentName: "Other", amountKobo: "30", balanceAfterKobo: "5" }],
+    credit: { studentId: "other", studentName: "Other", amountKobo: "20" }, ...over,
+});
+const mine = new Set(["mine"]);
+
+describe("receiptForGuardian", () => {
+    it("payer: whole total; other students only as one anonymous amount (lines AND credit)", () => {
+        const r = receiptForGuardian(base(), { isPayer: true, childIds: mine, status: "CONFIRMED" })!;
+        assert.equal(r.amountKobo, "150"); assert.deepEqual(r.otherStudents, { amountKobo: "50" }); assert.equal(r.credit, null);
+        assert.deepEqual(r.lines.map(l => l.studentId), ["mine"]);
+        assert.ok(!JSON.stringify(r).includes("Other") && !JSON.stringify(r).includes("I2"));
+    });
+    it("non-payer: only their share, no other lines or credit, no phone or reference", () => {
+        const r = receiptForGuardian(base(), { isPayer: false, childIds: mine, status: "CONFIRMED" })!;
+        assert.equal(r.amountKobo, "100"); assert.equal(r.partial, true); assert.equal(r.otherStudents, null);
+        assert.equal(r.payer.phone, null); assert.equal(r.reference, null); assert.equal(r.credit, null);
+    });
+    it("credit for the guardian's own child is kept and counted in their share", () => {
+        const r = receiptForGuardian(base({ credit: { studentId: "mine", studentName: "Mine", amountKobo: "20" } }), { isPayer: false, childIds: mine, status: "CONFIRMED" })!;
+        assert.equal(r.amountKobo, "120"); assert.equal(r.credit?.amountKobo, "20");
+    });
+    it("not the payer and no child on it: nothing (null)", () => {
+        assert.equal(receiptForGuardian(base(), { isPayer: false, childIds: new Set(["stranger"]), status: "CONFIRMED" }), null);
+        assert.equal(receiptForGuardian(base(), { isPayer: false, childIds: new Set(), status: "CONFIRMED" }), null);
+    });
+    it("a payer with none of their own children on it still gets the receipt, all other students anonymous", () => {
+        const r = receiptForGuardian(base(), { isPayer: true, childIds: new Set(), status: "CONFIRMED" })!;
+        assert.equal(r.lines.length, 0); assert.deepEqual(r.otherStudents, { amountKobo: "150" }); assert.equal(r.amountKobo, "150");
+    });
+    it("a damaged amount counts as zero rather than breaking the receipt", () => {
+        const r = receiptForGuardian(base({ lines: [{ invoiceNumber: "I1", studentId: "mine", studentName: "Mine", amountKobo: "oops", balanceAfterKobo: "0" }], credit: null }), { isPayer: false, childIds: mine, status: "CONFIRMED" })!;
+        assert.equal(r.amountKobo, "0");
+    });
+    it("shareForStudents adds only the given students", () => {
+        assert.equal(shareForStudents([{ studentId: "a", amountKobo: 5n }, { studentId: "b", amountKobo: 7n }, { studentId: "a", amountKobo: 1n }], new Set(["a"])), 6n);
+    });
+});
diff --git a/apps/api/tests/finance/family-payments.db.test.ts b/apps/api/tests/finance/family-payments.db.test.ts
new file mode 100644
index 0000000..d44d50c
--- /dev/null
+++ b/apps/api/tests/finance/family-payments.db.test.ts
@@ -0,0 +1,166 @@
+/*
+| GUARDIAN PAYMENTS AND RECEIPTS, on a real database.
+| A guardian sees what they paid, plus confirmed payments by other people that cover their own children (their share
+| only). Never another family's child, never another payer's phone or reference, never someone's pending attempt.
+*/
+import { describe, it, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { createTestSchool, dbTestsEnabled, skipReason, TestSchool } from "../helpers/test-database";
+import { seed } from "../attendance/fixtures";
+import { PaymentRepositoryImpl } from "../../src/modules/payments/repositories/payment.repository.impl";
+import { PaymentContextRepositoryImpl } from "../../src/modules/payments/repositories/payment-context.repository.impl";
+import { PaymentMapper } from "../../src/modules/payments/mappers/payment.mapper";
+import { ListMyPaymentsUseCase, GetMyReceiptUseCase } from "../../src/modules/payments/usecases/family-payments.usecases";
+
+const NOW = new Date("2026-02-10T09:00:00Z");
+
+describe("guardian payments and receipts (real database)", { skip: dbTestsEnabled ? false : skipReason }, () => {
+    let school: TestSchool;
+    let W: any;
+    const db = () => (require("../../src/infrastructure/database/prisma/prisma.client") as any).getTenantClient();
+    const deps = () => { const paymentMapper = new PaymentMapper(); return { paymentRepository: new PaymentRepositoryImpl({ paymentMapper } as any), paymentContextRepository: new PaymentContextRepositoryImpl(), paymentMapper } as any; };
+    const list = async (guardianId: string, q: any = {}) => (await new ListMyPaymentsUseCase(deps()).execute(guardianId, { page: 1, limit: 100, ...q })).data;
+    const ids = (rows: any[]) => rows.map(r => r.id).sort();
+    const receipt = (paymentId: string, guardianId: string) => new GetMyReceiptUseCase(deps()).execute(paymentId, guardianId);
+    const notFound = (e: any) => e?.statusCode === 404;
+
+    before(async () => {
+        school = await createTestSchool();
+        W = await school.run(async () => {
+            const S = await seed();                                       // s1 Ada (G1's child), s2 Bola, s4 Dayo; G1 = S.guardian, linked to s1
+            const d = db();
+            S.guardian = await d.guardian.update({ where: { id: S.guardian.id }, data: { phone: "0800Gina" } });   // the seed gives her none
+            const mk = (firstName: string, email: string) => d.guardian.create({ data: { firstName, lastName: "Parent", email, phone: "0800" + firstName } });
+            const G2 = await mk("Femi", "femi@x.com");                    // Ada's father: a second parent of s1
+            const G3 = await mk("Tolu", "tolu@x.com");                    // another family: Dayo's parent
+            const G4 = await mk("Nobody", "nobody@x.com");                // linked to no one
+            await d.studentGuardian.create({ data: { guardianId: G2.id, studentId: S.s1.id, relation: "father", isPrimary: false } });
+            await d.studentGuardian.create({ data: { guardianId: G3.id, studentId: S.s4.id, relation: "father", isPrimary: true } });
+            const account = await d.ledgerAccount.create({ data: { code: "1000", name: "Cash", type: "ASSET", isMoneyAccount: true } });
+
+            const names: Record<string, string> = { [S.s1.id]: "Ada Pupil", [S.s4.id]: "Dayo Pupil" };
+            let n = 0;
+            const pay = async (o: { key: string; payer: any; status: string; covers: [any, number][]; receipt?: boolean; phone?: string }) => {
+                n++;
+                const total = o.covers.reduce((s, [, k]) => s + k, 0);
+                const p = await d.payment.create({ data: {
+                    payerType: "GUARDIAN", guardianId: o.payer.id, payerName: `${o.payer.firstName} Parent`, payerPhone: o.payer.phone, method: "cash", amountKobo: BigInt(total), unallocatedKobo: 0n,
+                    accountId: account.id, status: o.status, reference: `REF-${o.key}`, paidAt: NOW, createdAt: new Date(NOW.getTime() + n * 1000),
+                    allocations: { create: o.covers.map(([s, k]) => ({ studentId: s.id, amountKobo: BigInt(k), invoiceId: null })) },
+                } });
+                if (o.receipt !== false) {
+                    await d.receipt.create({ data: { receiptNumber: `RCT-${o.key}`, paymentId: p.id, issuedAt: NOW, snapshot: {
+                        receiptNumber: `RCT-${o.key}`, issuedAt: NOW.toISOString(), paidOn: "2026-02-10",
+                        school: { name: "Greenfield", address: null, logoUrl: null, principalName: null },
+                        payer: { type: "GUARDIAN", name: `${o.payer.firstName} Parent`, phone: o.payer.phone }, method: "cash", reference: `REF-${o.key}`, amountKobo: String(total),
+                        lines: o.covers.map(([s, k]) => ({ invoiceNumber: `INV-${o.key}-${names[s.id]?.split(" ")[0]}`, studentId: s.id, studentName: names[s.id], amountKobo: String(k), balanceAfterKobo: "0" })),
+                        credit: null,
+                    } } });
+                }
+                return p.id as string;
+            };
+            const P: Record<string, string> = {};
+            P.own        = await pay({ key: "own",  payer: S.guardian, status: "CONFIRMED", covers: [[S.s1, 100]] });                    // G1 paid for Ada
+            P.byOther    = await pay({ key: "oth",  payer: G3,         status: "CONFIRMED", covers: [[S.s1, 30], [S.s4, 70]] });         // G3 paid for Ada AND Dayo
+            P.otherPend  = await pay({ key: "opd",  payer: G3,         status: "PENDING",   covers: [[S.s1, 10]], receipt: false });     // G3's attempt, not confirmed
+            P.otherOnly  = await pay({ key: "oly",  payer: G3,         status: "CONFIRMED", covers: [[S.s4, 55]] });                     // G3 for Dayo only
+            P.ownPend    = await pay({ key: "pnd",  payer: S.guardian, status: "PENDING",   covers: [[S.s1, 25]], receipt: false });     // G1's own pending
+            P.mixedOwn   = await pay({ key: "mix",  payer: S.guardian, status: "CONFIRMED", covers: [[S.s1, 40], [S.s4, 60]] });         // G1 paid for Ada AND Dayo
+            P.reversed   = await pay({ key: "rev",  payer: G3,         status: "REVERSED",  covers: [[S.s1, 20]] });                     // G3 for Ada, later reversed
+            return { S, G2, G3, G4, P };
+        });
+    });
+    after(async () => { await school.drop(); });
+
+    const G1 = () => W.S.guardian.id;
+
+    describe("the list", () => {
+        it("G1 sees what they paid (any state), plus CONFIRMED/REVERSED payments by others that cover Ada; never G3's pending or Dayo-only payments", () => school.run(async () => {
+            const { P } = W;
+            assert.deepEqual(ids(await list(G1())), ids([{ id: P.own }, { id: P.byOther }, { id: P.ownPend }, { id: P.mixedOwn }, { id: P.reversed }]));
+        }));
+        it("a payment by someone else shows only the share for G1's child, and none of the payer's private details", () => school.run(async () => {
+            const row = (await list(G1())).find(r => r.id === W.P.byOther);
+            assert.equal(row.amountKobo, 30); assert.equal(row.partial, true); assert.equal(row.isPayer, false);
+            assert.equal(row.guardianId, null); assert.equal(row.reference, null); assert.equal(row.unallocatedKobo, null);
+            assert.equal(row.receiptNumber, "RCT-oth");
+        }));
+        it("a payment G1 made keeps the whole amount, even when part of it was for another family's child", () => school.run(async () => {
+            const row = (await list(G1())).find(r => r.id === W.P.mixedOwn);
+            assert.equal(row.amountKobo, 100); assert.equal(row.isPayer, true); assert.equal(row.partial, false); assert.equal(row.reference, "REF-mix");
+        }));
+        it("a reversed payment for G1's child is still listed, marked REVERSED", () => school.run(async () => {
+            const row = (await list(G1())).find(r => r.id === W.P.reversed);
+            assert.equal(row.status, "REVERSED"); assert.equal(row.amountKobo, 20);
+        }));
+        it("the second parent (G2) sees Ada's payments too, but only a share of the mixed ones", () => school.run(async () => {
+            const rows = await list(W.G2.id);
+            assert.deepEqual(ids(rows), ids([{ id: W.P.own }, { id: W.P.byOther }, { id: W.P.mixedOwn }, { id: W.P.reversed }]));
+            assert.equal(rows.find(r => r.id === W.P.mixedOwn).amountKobo, 40, "only Ada's part of what G1 paid");
+            assert.equal(rows.find(r => r.id === W.P.mixedOwn).payerName, "Gina Parent");
+        }));
+        it("another family (G3) sees its own and what covers Dayo, and nothing about Ada alone", () => school.run(async () => {
+            const rows = await list(W.G3.id);
+            assert.deepEqual(ids(rows), ids([{ id: W.P.byOther }, { id: W.P.otherPend }, { id: W.P.otherOnly }, { id: W.P.mixedOwn }, { id: W.P.reversed }]));
+            assert.equal(rows.find(r => r.id === W.P.mixedOwn).amountKobo, 60);
+            assert.ok(!rows.some(r => r.id === W.P.own || r.id === W.P.ownPend), "G1's payments for Ada alone are not G3's");
+        }));
+        it("a guardian linked to nobody sees nothing", () => school.run(async () => {
+            assert.deepEqual(await list(W.G4.id), []);
+        }));
+        it("filters narrow, never widen: someone else's child gives nothing; the payer / branch filters are ignored", () => school.run(async () => {
+            assert.deepEqual(await list(G1(), { studentId: W.S.s4.id }), [], "Dayo is not G1's child");
+            assert.deepEqual(ids(await list(G1(), { studentId: W.S.s1.id })), ids([{ id: W.P.own }, { id: W.P.byOther }, { id: W.P.ownPend }, { id: W.P.mixedOwn }, { id: W.P.reversed }]));
+            assert.deepEqual(ids(await list(G1(), { status: "PENDING" })), [W.P.ownPend], "G3's pending attempt never appears");
+            assert.deepEqual(ids(await list(G1(), { guardianId: W.G3.id })), ids(await list(G1())), "asking for another payer changes nothing");
+        }));
+        it("when the link to the child is removed, the other people's payments for that child disappear; own ones stay", () => school.run(async () => {
+            const link = await db().studentGuardian.findFirst({ where: { guardianId: G1(), studentId: W.S.s1.id } });
+            await db().studentGuardian.delete({ where: { id: link.id } });
+            try {
+                assert.deepEqual(ids(await list(G1())), ids([{ id: W.P.own }, { id: W.P.ownPend }, { id: W.P.mixedOwn }]));
+            } finally { await db().studentGuardian.create({ data: { guardianId: G1(), studentId: W.S.s1.id, relation: "mother", isPrimary: false } }); }
+        }));
+    });
+
+    describe("the receipt", () => {
+        it("the payer gets the whole receipt, with their own phone and the reference", () => school.run(async () => {
+            const r = await receipt(W.P.own, G1());
+            assert.equal(r.amountKobo, "100"); assert.equal(r.partial, false); assert.equal(r.reference, "REF-own"); assert.equal(r.payer.phone, "0800Gina");
+            assert.equal(r.lines.length, 1); assert.equal(r.otherStudents, null); assert.equal(r.status, "CONFIRMED");
+        }));
+        it("someone else's payment: only G1's child's line and share; no other child, no payer phone, no reference", () => school.run(async () => {
+            const r = await receipt(W.P.byOther, G1());
+            assert.equal(r.amountKobo, "30"); assert.equal(r.partial, true);
+            assert.deepEqual(r.lines.map((l: any) => l.studentName), ["Ada Pupil"]);
+            assert.equal(r.payer.phone, null); assert.equal(r.reference, null); assert.equal(r.otherStudents, null);
+            const text = JSON.stringify(r);
+            for (const secret of ["Dayo", "INV-oth-Dayo", "0800Tolu", "REF-oth"]) assert.ok(!text.includes(secret), `leaked ${secret}`);
+        }));
+        it("a payment G1 made that also covered another family's child: full total, that child only as one anonymous amount", () => school.run(async () => {
+            const r = await receipt(W.P.mixedOwn, G1());
+            assert.equal(r.amountKobo, "100"); assert.deepEqual(r.lines.map((l: any) => l.studentName), ["Ada Pupil"]);
+            assert.deepEqual(r.otherStudents, { amountKobo: "60" });
+            const text = JSON.stringify(r);
+            for (const secret of ["Dayo", "INV-mix-Dayo"]) assert.ok(!text.includes(secret), `leaked ${secret}`);
+        }));
+        it("the second parent can open the receipt for their child, as a non-payer", () => school.run(async () => {
+            const r = await receipt(W.P.own, W.G2.id);
+            assert.equal(r.amountKobo, "100"); assert.equal(r.partial, true); assert.equal(r.payer.phone, null); assert.equal(r.reference, null);
+        }));
+        it("a reversed payment's receipt is available and says REVERSED", () => school.run(async () => {
+            assert.equal((await receipt(W.P.reversed, G1())).status, "REVERSED");
+        }));
+        it("not found, the same way, for: another family's payment, a pending payment (no receipt), a guardian with no link, and an id that does not exist", () => school.run(async () => {
+            await assert.rejects(receipt(W.P.otherOnly, G1()), notFound);
+            await assert.rejects(receipt(W.P.otherPend, G1()), notFound);
+            await assert.rejects(receipt(W.P.own, W.G4.id), notFound);
+            await assert.rejects(receipt("00000000-0000-4000-8000-000000000000", G1()), notFound);
+        }));
+        it("the answer for 'not yours' and 'does not exist' is identical (nothing is confirmed)", () => school.run(async () => {
+            const a: any = await receipt(W.P.otherOnly, G1()).catch(e => e);
+            const b: any = await receipt("00000000-0000-4000-8000-000000000000", G1()).catch(e => e);
+            assert.equal(a.message, b.message); assert.equal(a.statusCode, b.statusCode); assert.equal(a.code, b.code);
+        }));
+    });
+});
