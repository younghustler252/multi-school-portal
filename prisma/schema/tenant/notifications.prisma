model SchoolNotification {
    id         String                       @id @default(uuid())
    title      String
    message    String
    type       SchoolNotificationType
    targetType TargetType
    sentById   String
    metadata   Json?
    sentAt     DateTime?
    createdAt  DateTime                     @default(now())
    updatedAt  DateTime                     @updatedAt
    recipients SchoolNotificationRecipient[]

    @@index([type])
    @@index([createdAt(sort: Desc)])
}

model SchoolNotificationRecipient {
    id             String               @id @default(uuid())
    notificationId String
    studentId      String?
    guardianId     String?
    staffId        String?
    channel        NotificationChannel
    status         DeliveryStatus       @default(PENDING)
    priority       NotificationPriority @default(NORMAL)
    retryCount     Int                  @default(0)
    failedReason   String?
    providerMsgId  String?
    readAt         DateTime?
    deliveredAt    DateTime?
    createdAt      DateTime             @default(now())
    updatedAt      DateTime             @updatedAt

    notification   SchoolNotification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)

    // No relations to Student, Guardian, Staff
    // These are resolved in application code using the tenant Prisma client
    // Cross-schema foreign keys are not supported in PostgreSQL

    @@unique([notificationId, channel, studentId, guardianId, staffId])
    @@index([status])
    @@index([status, priority, createdAt])
}

enum SchoolNotificationType {
  fee_invoice
  fee_reminder
  fee_receipt
  report_card_ready
  attendance_alert
  event
  holiday
  broadcast
  custom
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TargetType {
  STUDENT
  GUARDIAN
  STAFF
  ALL_PARENTS
  ALL_STUDENTS
  ALL_STAFF
  EVERYONE
}
