model SchoolNotification {
  id           String                        @id @default(uuid())
  title        String
  message      String
  type         SchoolNotificationType
  targetType   TargetType               
  sentById     String                   
  metadata     Json?
  sentAt       DateTime?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  recipients   SchoolNotificationRecipient[]

  @@index([type])
  @@index([createdAt(sort: Desc)])
}

model SchoolNotificationRecipient {
  id             String               @id @default(uuid())
  notificationId String
  // one of these will be set depending on recipient type
  studentId      String?
  guardianId     String?
  staffId        String?
  channel        NotificationChannel
  status         DeliveryStatus       @default(PENDING)
  priority       NotificationPriority @default(NORMAL)
  retryCount     Int                  @default(0)
  failedReason   String?
  providerMsgId  String?
  readAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  notification   SchoolNotification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  student        Student?             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian       Guardian?            @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  staff          Staff?               @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel, studentId, guardianId, staffId])
  @@index([status])
  @@index([status, priority, createdAt])
}

enum SchoolNotificationType {
  fee_invoice
  fee_reminder
  fee_receipt
  report_card_ready
  attendance_alert
  event
  holiday
  broadcast
  custom
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TargetType {
  STUDENT
  GUARDIAN
  STAFF
  ALL_PARENTS
  ALL_STUDENTS
  ALL_STAFF
  EVERYONE
}
