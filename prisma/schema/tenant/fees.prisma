// ===== FEES + PAYMENTS (tenant schema) =====

model FeeType {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  feeInvoices FeeInvoice[]
}

model FeeInvoice {
  id          String        @id @default(uuid())
  studentId   String
  termId      String
  feeTypeId   String
  amountKobo  Int
  paidKobo    Int           @default(0)
  balanceKobo Int           @default(0)
  status      InvoiceStatus @default(unpaid)
  dueDate     DateTime?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  student     Student       @relation(fields: [studentId], references: [id])
  term        Term          @relation(fields: [termId], references: [id])
  feeType     FeeType       @relation(fields: [feeTypeId], references: [id])
  payments    Payment[]
}

enum InvoiceStatus {
  unpaid
  partial
  paid
  waived
}

model Payment {
  id               String        @id @default(uuid())
  feeInvoiceId     String
  guardianId       String?
  amountKobo       Int
  method           PaymentMethod
  channel          String?
  reference        String?       @unique
  status           PaymentStatus @default(pending)
  webhookVerified  Boolean       @default(false)
  providerResponse Json?
  receiptUrl       String?
  recordedById     String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  feeInvoice       FeeInvoice    @relation(fields: [feeInvoiceId], references: [id])
  guardian         Guardian?     @relation(fields: [guardianId], references: [id])
}

enum PaymentMethod {
  paystack
  flutterwave
  bank_transfer
  cash
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}