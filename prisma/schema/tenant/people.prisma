// ===== PEOPLE (tenant schema) =====

model Staff {
  id            String    @id @default(uuid())
  userId        String    @unique
  employeeId    String?   @unique
  department    String?
  designation   String?
  qualification String?
  gender        Gender?
  dateOfBirth   DateTime?
  address       String?
  joinDate      DateTime?
  role          StaffRole
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  classSubjects ClassSubject[]
  notifications  SchoolNotificationRecipient[]
}

enum StaffRole {
  school_admin
  principal
  teacher
  bursar
  other
}

enum Gender {
  male
  female
}

model Student {
  id              String    @id @default(uuid())
  userId          String?   @unique
  admissionNumber String?   @unique
  firstName       String
  lastName        String
  middleName      String?
  dateOfBirth     DateTime?
  gender          Gender?
  bloodGroup      String?
  address         String?
  photoUrl        String?
  religion        String?
  nationality     String?   @default("Nigerian")
  stateOfOrigin   String?
  isActive        Boolean   @default(true)
  admittedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  enrolments      Enrolment[]
  guardianLinks   StudentGuardian[]
  attendances     Attendance[]
  grades          Grade[]
  feeInvoices     FeeInvoice[]
  reportCards     ReportCard[]
  notifications  SchoolNotificationRecipient[]
}

model Guardian {
  id          String    @id @default(uuid())
  userId      String?   @unique
  firstName   String
  lastName    String
  email       String
  phone       String?
  occupation  String?
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  studentLinks StudentGuardian[]
  payments    Payment[]
  notifications  SchoolNotificationRecipient[]

}

model StudentGuardian {
  id           String          @id @default(uuid())
  studentId    String
  guardianId   String
  relation     GuardianRelation
  isPrimary    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  student      Student         @relation(fields: [studentId], references: [id])
  guardian     Guardian        @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
}

enum GuardianRelation {
  father
  mother
  uncle
  aunt
  grandparent
  sibling
  guardian
  other
}