// =====================
// AUTH / IDENTITY MODULE
// =====================

model User {
  id                String    @id @default(uuid())

  // tenant (optional for super_admin)
  schoolId          String?

  // identity
  email             String    @unique
  passwordHash      String

  // access control
  role              Role

  // profile
  firstName         String?
  lastName          String?
  phone             String?
  photoUrl          String?

  // account status
  isActive          Boolean   @default(true)
  isEmailVerified   Boolean   @default(false)
  emailVerifiedAt   DateTime?

  // security tracking
  lastLoginAt       DateTime?
  lastLoginIp       String?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime?

  // timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // relations
  school            School?   @relation(fields: [schoolId], references: [id])
  refreshTokens     RefreshToken[]
  otps              Otp[]
  invitesSent       Invite[]  @relation("InviteSender")
}

// =====================
// OTP (Authentication codes)
// =====================

model Otp {
  id        String   @id @default(uuid())

  userId    String
  code      String
  type      OtpType

  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================
// REFRESH TOKENS (sessions)
// =====================

model RefreshToken {
  id        String   @id @default(uuid())

  userId    String
  token     String   @unique

  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================
// INVITES (staff onboarding)
// =====================

model Invite {
  id          String   @id @default(uuid())

  email       String
  role        Role

  token       String   @unique
  schoolId    String

  sentById    String

  accepted    Boolean  @default(false)
  expiresAt   DateTime

  createdAt   DateTime @default(now())

  sentBy      User     @relation("InviteSender", fields: [sentById], references: [id])
}

// =====================
// ENUMS
// =====================

enum Role {
  super_admin
  school_admin
  principal
  teacher
  bursar
  student
  guardian
}

enum OtpType {
  email_verification
  password_reset
  two_factor
}