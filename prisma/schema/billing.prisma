// =====================
// BILLING / SUBSCRIPTION MODULE
// =====================
model Plan {
  id               String   @id @default(uuid())
  name             String   @unique
  description      String?

  // limits (-1 = unlimited)
  studentLimit     Int
  staffLimit       Int
  features         Json     @default("{}")

  monthlyPriceKobo Int      @default(0)
  yearlyPriceKobo  Int      @default(0)
  setupFeeKobo     Int      @default(0)

  // flags
  isPublic         Boolean  @default(true)
  isActive         Boolean  @default(true)
  isCustom         Boolean  @default(false)  // enterprise custom plans

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions    Subscription[]
}
// =====================
// SUBSCRIPTION (core billing engine)
// =====================
model Subscription {
  id                       String             @id @default(uuid())
  schoolId                 String
  planId                   String
  status                   SubscriptionStatus @default(active)
  billingCycle             BillingCycle       @default(monthly)
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  trialEndsAt              DateTime?
  cancelAtPeriodEnd        Boolean            @default(false)
  cancelledAt              DateTime?
  couponId                 String?
  discountedPriceKobo      Int?
  setupFeePaid             Boolean            @default(false)
  setupFeePaidAt           DateTime?
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  nextBillingDate          DateTime?
  lastBillingAttemptAt     DateTime?
  failedBillingCount       Int                @default(0)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  school                   School             @relation(fields: [schoolId], references: [id])
  plan                     Plan               @relation(fields: [planId], references: [id])
  coupon                   Coupon?            @relation(fields: [couponId], references: [id])
  billingHistory           BillingHistory[]
}

// =====================
// COUPONS / DISCOUNTS
// =====================

model Coupon {
  id              String   @id @default(uuid())

  code            String   @unique
  description     String?

  discountType    DiscountType
  discountValue   Int

  maxUses         Int?
  usedCount       Int      @default(0)

  validFrom       DateTime
  validUntil      DateTime?

  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   Subscription[]
}

// =====================
// BILLING HISTORY (payment logs)
// =====================

model BillingHistory {
  id                String        @id @default(uuid())

  subscriptionId    String

  amountKobo        Int
  status            PaymentStatus @default(pending)

  billingCycle      BillingCycle

  paystackReference String?

  paidAt            DateTime?
  failureReason     String?

  createdAt         DateTime @default(now())

  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
}

// =====================
// ENUMS
// =====================

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
  expired
}

enum BillingCycle {
  monthly
  yearly
}

enum DiscountType {
  percentage
  fixed_amount
}
