model PlatformNotification {
  id               String                          @id @default(uuid())
  title            String
  message          String
  type             PlatformNotificationType
  state            NotificationState               @default(QUEUED)
  createdByAdminId String
  metadata         Json?
  sentAt           DateTime?
  completedAt      DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  recipients       PlatformNotificationRecipient[]

  @@index([state, createdAt])
  @@index([type])
}

model PlatformNotificationRecipient {
  id             String               @id @default(uuid())
  notificationId String
  schoolId       String               
  channel        NotificationChannel
  status         DeliveryStatus       @default(PENDING)
  retryCount     Int                  @default(0)
  failedReason   String?
  readAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  notification   PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([notificationId, schoolId, channel])
  @@index([schoolId, status])
}

enum PlatformNotificationType {
  welcome
  feature_announcement
  subscription_expiry
  subscription_renewed
  subscription_failed
  account_suspended
  account_verified
  account_rejected
  system_alert
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationState {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}
