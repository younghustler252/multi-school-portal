generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/tenant"
}

datasource db {
  provider = "postgresql"
}

// ===== SHARED AUTHORIZATION ENUMS =====

enum Persona {
  STAFF
  STUDENT
  GUARDIAN
}

enum PermissionScope {
  ALL
  BRANCH
  ASSIGNED
  OWN
}

enum RoleKind {
  SYSTEM_LOCKED
  SYSTEM_EDITABLE
  CUSTOM
}

enum MembershipStatus {
  active
  suspended
  removed
}

enum StaffCategory {
  teaching
  non_teaching
}

enum EmploymentType {
  full_time
  part_time
  contract
  volunteer
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum DeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

// ===== PEOPLE =====

model Staff {
  id             String         @id @default(uuid())
  userId         String?        @unique
  employeeId     String?        @unique
  firstName      String
  lastName       String
  middleName     String?
  email          String?
  phone          String?
  photoUrl       String?
  gender         Gender?
  dateOfBirth    DateTime?
  address        String?
  department     String?
  designation    String?
  qualification  String?
  category       StaffCategory  @default(non_teaching)
  employmentType EmploymentType @default(full_time)
  joinDate       DateTime?
  exitDate       DateTime?
  exitReason     String?
  role           StaffRole      @default(other)
  isActive       Boolean        @default(true)
  createdById    String?
  updatedById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  classSubjects         ClassSubject[]
  classesAsClassTeacher Class[]
  subjectDefaults       Subject[] @relation("SubjectDefaultTeacher")
  branches              StaffBranch[]

  @@index([isActive])
  @@index([category])
  @@index([email])
  @@index([deletedAt])
}

enum StaffRole {
  school_admin
  principal
  teacher
  bursar
  other
}

enum Gender {
  male
  female
}

model Student {
  id              String    @id @default(uuid())
  userId          String?   @unique
  admissionNumber String?   @unique
  firstName       String
  lastName        String
  middleName      String?
  dateOfBirth     DateTime?
  gender          Gender?
  bloodGroup      String?
  address         String?
  photoUrl        String?
  religion        String?
  nationality     String?   @default("Nigerian")
  stateOfOrigin   String?
  isActive        Boolean   @default(true)
  admittedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enrolments    Enrolment[]
  guardianLinks StudentGuardian[]
  attendances   Attendance[]
  grades        Grade[]
  feeInvoices   FeeInvoice[]
  reportCards   ReportCard[]
}

model Guardian {
  id           String   @id @default(uuid())
  userId       String?  @unique
  firstName    String
  lastName     String
  email        String
  phone        String?
  occupation   String?
  address      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentLinks StudentGuardian[]
  payments     Payment[]
}

model StudentGuardian {
  id         String          @id @default(uuid())
  studentId  String
  guardianId String
  relation   GuardianRelation
  isPrimary  Boolean         @default(false)
  createdAt  DateTime        @default(now())

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
}

enum GuardianRelation {
  father
  mother
  uncle
  aunt
  grandparent
  sibling
  guardian
  other
}

// ===== ACADEMIC =====

model CalendarEvent {
  id          String    @id @default(uuid())
  termId      String?
  sessionId   String?
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  type        EventType @default(event)
  isHoliday   Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  term    Term?    @relation(fields: [termId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([startDate])
  @@index([termId])
}

enum EventType {
  holiday
  event
  exam
  break
  other
}

model Session {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms          Term[]
  calendarEvents CalendarEvent[]
  journalEntries JournalEntry[]
}

model Term {
  id        String   @id @default(uuid())
  sessionId String
  name      TermName
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session        Session         @relation(fields: [sessionId], references: [id])
  classSubjects  ClassSubject[]
  attendances    Attendance[]
  calendarEvents CalendarEvent[]
  grades         Grade[]
  feeInvoices    FeeInvoice[]
  enrolments     Enrolment[]
  reportCards    ReportCard[]
  journalEntries JournalEntry[]
}

enum TermName {
  first
  second
  third
}

model Class {
  id             String   @id @default(uuid())
  name           String
  level          String?
  capacity       Int?
  classTeacherId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classTeacher     Staff?             @relation(fields: [classTeacherId], references: [id])
  enrolments       Enrolment[]
  classSubjects    ClassSubject[]
  progressionsFrom ClassProgression[] @relation("ProgressionFrom")
  progressionsTo   ClassProgression[] @relation("ProgressionTo")
}

model Subject {
  id               String   @id @default(uuid())
  name             String
  code             String?  @unique
  description      String?
  defaultTeacherId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  defaultTeacher Staff?         @relation("SubjectDefaultTeacher", fields: [defaultTeacherId], references: [id])
  classSubjects  ClassSubject[]
}

model ClassSubject {
  id          String                       @id @default(uuid())
  classId     String
  subjectId   String
  staffId     String
  termId      String
  assignedVia ClassSubjectAssignmentSource @default(manual)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])
  grades  Grade[]

  @@unique([classId, subjectId, termId])
}

enum ClassSubjectAssignmentSource {
  manual
  auto_subject_default
  auto_homeroom
}

model Enrolment {
  id        String          @id @default(uuid())
  studentId String
  classId   String
  termId    String
  status    EnrolmentStatus @default(active)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
}

enum EnrolmentStatus {
  active
  withdrawn
  transferred
  completed
}

model ClassProgression {
  id          String   @id @default(uuid())
  fromClassId String   @unique
  toClassId   String?
  fromClass   Class    @relation("ProgressionFrom", fields: [fromClassId], references: [id])
  toClass     Class?   @relation("ProgressionTo", fields: [toClassId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TeachingModel {
  homeroom
  subject_specialist
}

// ===== SCHOOL SETTINGS =====

model SchoolSettings {
  id                        String        @id @default(uuid())
  logoUrl                   String?
  primaryColor              String?       @default("#1a1a2e")
  secondaryColor            String?
  motto                     String?
  address                   String?
  website                   String?
  foundedYear               Int?
  principalName             String?
  stamp                     String?
  reportCardTemplate        String        @default("classic")
  reportCardLetterheadUrl   String?
  letterheadContentTopMm    Int?          @default(50)
  letterheadContentBottomMm Int?          @default(30)
  allowStudentLogin         Boolean       @default(false)
  signature                 String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  teachingModel             TeachingModel?
}

// ===== ATTENDANCE =====

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  termId    String
  date      DateTime
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, date])
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

// ===== GRADES AND REPORT CARDS =====

model Grade {
  id             String       @id @default(uuid())
  studentId      String
  termId         String
  classSubjectId String
  caScore        Float?
  examScore      Float?
  total          Float?
  grade          String?
  remark         String?
  position       Int?
  totalStudents  Int?
  isPublished    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id])

  @@unique([studentId, termId, classSubjectId])
}

model GradingConfig {
  id        String   @id @default(uuid())
  minScore  Float
  maxScore  Float
  grade     String
  remark    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportCard {
  id              String           @id @default(uuid())
  studentId       String
  termId          String
  status          ReportCardStatus @default(draft)
  teacherRemark   String?
  principalRemark String?
  totalScore      Float?
  averageScore    Float?
  position        Int?
  totalStudents   Int?
  pdfUrl          String?
  emailSentAt     DateTime?
  smsSentAt       DateTime?
  generatedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
}

enum ReportCardStatus {
  draft
  generated
  published
  sent
}

// ===== FEES AND PAYMENTS =====

model FeeType {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  invoiceItems FeeInvoiceItem[]
}

model FeeInvoice {
  id           String        @id @default(uuid())
  studentId    String
  termId       String
  discountKobo Int           @default(0)
  status       InvoiceStatus @default(unpaid)
  dueDate      DateTime?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student  Student          @relation(fields: [studentId], references: [id])
  term     Term             @relation(fields: [termId], references: [id])
  items    FeeInvoiceItem[]
  payments Payment[]

  @@unique([studentId, termId])
}

model FeeInvoiceItem {
  id           String   @id @default(uuid())
  feeInvoiceId String
  feeTypeId    String
  amountKobo   Int
  createdAt    DateTime @default(now())

  feeInvoice FeeInvoice @relation(fields: [feeInvoiceId], references: [id])
  feeType    FeeType    @relation(fields: [feeTypeId], references: [id])
}

enum InvoiceStatus {
  unpaid
  partial
  paid
  waived
}

model Payment {
  id               String        @id @default(uuid())
  feeInvoiceId     String
  guardianId       String?
  amountKobo       Int
  method           PaymentMethod
  channel          String?
  reference        String?       @unique
  status           PaymentStatus @default(pending)
  webhookVerified  Boolean       @default(false)
  providerResponse Json?
  receiptUrl       String?
  recordedById     String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  feeInvoice FeeInvoice @relation(fields: [feeInvoiceId], references: [id])
  guardian   Guardian?  @relation(fields: [guardianId], references: [id])
}

enum PaymentMethod {
  paystack
  flutterwave
  bank_transfer
  cash
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

// ===== SCHOOL ROLE MANAGEMENT =====

model SchoolRole {
  id                    String   @id @default(uuid())
  name                  String
  description           String?
  kind                  RoleKind
  persona               Persona  @default(STAFF)
  grantsAll             Boolean  @default(false)
  sourceTemplateKey     String?
  sourceTemplateVersion Int?
  isCustomized          Boolean  @default(false)
  createdById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  permissions SchoolRolePermission[]
  members     MembershipRole[]

  @@index([sourceTemplateKey])
}

model SchoolRolePermission {
  roleId        String
  permissionKey String
  scope         PermissionScope @default(ALL)

  role SchoolRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

// One row per portal account per persona. Contact-only guardians and students
// without logins do not need a membership.

model Membership {
  id              String           @id @default(uuid())
  userId          String
  persona         Persona
  personaEntityId String
  status          MembershipStatus @default(active)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  roles MembershipRole[]

  @@unique([userId, persona])
  @@unique([persona, personaEntityId])
  @@index([userId])
  @@index([status])
}

model MembershipRole {
  membershipId String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       SchoolRole @relation(fields: [roleId], references: [id])

  @@id([membershipId, roleId])
  @@index([roleId])
}

// ===== BRANCH MANAGEMENT =====

model Branch {
  id               String    @id @default(uuid())
  name             String
  code             String    @unique
  isMain           Boolean   @default(false)
  address          String?
  city             String?
  state            String?
  phone            String?
  email            String?
  principalStaffId String?
  isActive         Boolean   @default(true)
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  staff          StaffBranch[]
  journalEntries JournalEntry[]

  @@index([isActive])
  @@index([deletedAt])
}

// Where a staff member works. This table also determines which branches
// their BRANCH-scoped roles may access.

model StaffBranch {
  staffId      String
  branchId     String
  isPrimary    Boolean  @default(false)
  assignedAt   DateTime @default(now())
  assignedById String?

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([staffId, branchId])
  @@index([branchId])
}

// ===== SCHOOL SETTINGS OVERRIDES =====

// One row per overridden key. Deleting the row restores the platform default.

model SchoolSettingValue {
  key         String   @id
  value       Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== AUTOMATION =====

model AutomationRule {
  id            String   @id @default(uuid())
  definitionKey String
  name          String
  enabled       Boolean  @default(false)
  params        Json
  channels      NotificationChannel[]
  audience      Json?
  templateKey   String?
  schedule      Json?
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  runs AutomationRunLog[]

  @@index([definitionKey])
  @@index([enabled, nextRunAt])
}

model AutomationRunLog {
  id             String              @id @default(uuid())
  ruleId         String
  triggeredAt    DateTime            @default(now())
  trigger        String
  status         AutomationRunStatus
  matched        Int                 @default(0)
  notified       Int                 @default(0)
  skippedReason  String?
  error          String?
  notificationId String?

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, triggeredAt])
}

enum AutomationRunStatus {
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

// ===== SCHOOL MESSAGE TEMPLATES =====

model SchoolMessageTemplate {
  id          String             @id @default(uuid())
  key         String
  channel     NotificationChannel
  locale      String             @default("en")
  subject     String?
  body        String
  isActive    Boolean            @default(true)
  updatedById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([key, channel, locale])
  @@index([isActive])
}

// ===== NUMBER SEQUENCES =====

// Gapless per-school counters for admission numbers, invoices, receipts, and payslips.
// The period resets a counter; an empty string means the counter never resets.

model NumberSequence {
  key       String
  period    String   @default("")
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  @@id([key, period])
}

// ===== ATTACHMENTS =====

// Shared file metadata for student and staff documents, receipts, payslips, and letters.
// sizeBytes can be used as the storage entitlement meter source.

model Attachment {
  id           String    @id @default(uuid())
  ownerType    String
  ownerId      String
  kind         String
  fileName     String
  fileUrl      String
  mimeType     String?
  sizeBytes    Int       @default(0)
  uploadedById String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([ownerType, ownerId])
  @@index([deletedAt])
}

// ===== SCHOOL NOTIFICATIONS =====

model SchoolNotification {
  id         String                  @id @default(uuid())
  title      String
  message    String
  type       SchoolNotificationType
  targetType TargetType
  sentById   String
  metadata   Json?
  sentAt     DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  recipients SchoolNotificationRecipient[]

  @@index([type])
  @@index([createdAt(sort: Desc)])
}

model SchoolNotificationRecipient {
  id                String               @id @default(uuid())
  notificationId    String
  recipientType     RecipientType
  recipientEntityId String
  userId            String?
  channel           NotificationChannel
  status            DeliveryStatus       @default(PENDING)
  priority          NotificationPriority @default(NORMAL)
  retryCount        Int                  @default(0)
  failedReason      String?
  providerMsgId     String?
  idempotencyKey    String?              @unique
  queuedAt          DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  nextRetryAt       DateTime?
  readAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  notification SchoolNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel, recipientType, recipientEntityId])
  @@index([status])
  @@index([status, priority, createdAt])
  @@index([recipientType, recipientEntityId])
}

enum SchoolNotificationType {
  fee_invoice
  fee_reminder
  fee_receipt
  report_card_ready
  attendance_alert
  event
  holiday
  broadcast
  custom
}

enum RecipientType {
  STUDENT
  GUARDIAN
  STAFF
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TargetType {
  STUDENT
  GUARDIAN
  STAFF
  ALL_PARENTS
  ALL_STUDENTS
  ALL_STAFF
  EVERYONE
}

// ===========================================================================
// FINANCE: THE BOOKS  (owned by the Finance workspace; see FINANCE_MODULE_BRIEF.md)
// Money is whole kobo in BigInt. Accounting dates are calendar dates (DATE), so a Nigerian
// midnight never slips to the day before. A posted journal can never be edited or deleted
// (database triggers in the finance_books migration); a mistake is fixed by a reversal.
// Only the finance workspace edits this block. The back-relation lines this block needs
// (journalEntries on Branch, Term and Session) are the only edits outside it.
// ===========================================================================

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalStatus {
  POSTED
  REVERSED
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum JournalSourceType {
  FEE_INVOICE
  PAYMENT
  REFUND
  ADJUSTMENT
  EXPENSE_BILL
  EXPENSE_PAYMENT
  PAYROLL_ACCRUAL
  PAYROLL_PAYMENT
  PAYROLL_REMITTANCE
  TRANSFER
  OPENING_BALANCE
  MANUAL
  REVERSAL
}

// Who a journal line is about, so reports can show who owes what
enum LedgerPartyType {
  STUDENT
  GUARDIAN
  VENDOR
  STAFF
}

// A labeled bucket in the school's books: Cash, Tuition Income, Salaries ...
// One chart of accounts per school (branches share it; a journal records its branch).
model LedgerAccount {
  id                 String            @id @default(uuid())
  code               String            @unique
  name               String
  type               LedgerAccountType
  subtype            String            @default("GENERAL")
  systemKey          String?           @unique
  parentId           String?
  description        String?
  isMoneyAccount     Boolean           @default(false)
  bankName           String?
  accountName        String?
  accountNumberLast4 String?
  isActive           Boolean           @default(true)
  isLocked           Boolean           @default(false)
  sortOrder          Int               @default(0)
  createdById        String?
  updatedById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  parent   LedgerAccount?  @relation("LedgerAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children LedgerAccount[] @relation("LedgerAccountTree")
  lines    JournalLine[]

  @@index([type])
  @@index([parentId])
  @@index([isActive])
  @@index([deletedAt])
}

// An accounting month. A closed period cannot receive postings.
model FinancePeriod {
  id           String       @id @default(uuid())
  name         String       @unique
  startDate    DateTime     @unique @db.Date
  endDate      DateTime     @db.Date
  status       PeriodStatus @default(OPEN)
  closedAt     DateTime?
  closedById   String?
  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  journals JournalEntry[]
}

// One money event. Immutable once posted; only status may change (POSTED to REVERSED).
// idempotencyKey is built by the posting service from source type, source id and purpose,
// so the same event can never post twice. A reversal points back at the journal it undoes.
model JournalEntry {
  id             String            @id @default(uuid())
  number         String            @unique
  entryDate      DateTime          @db.Date
  periodId       String
  termId         String?
  sessionId      String?
  branchId       String?
  description    String
  sourceType     JournalSourceType
  sourceId       String?
  purpose        String
  idempotencyKey String            @unique
  status         JournalStatus     @default(POSTED)
  reversalOfId   String?           @unique
  reversalReason String?
  totalKobo      BigInt
  createdById    String?
  isSystemActor  Boolean           @default(false)
  postedAt       DateTime          @default(now())
  createdAt      DateTime          @default(now())

  period     FinancePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  term       Term?         @relation(fields: [termId], references: [id], onDelete: Restrict)
  session    Session?      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  branch     Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reversalOf JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry? @relation("JournalReversal")
  lines      JournalLine[]

  @@index([periodId])
  @@index([entryDate])
  @@index([sourceType, sourceId])
  @@index([termId])
  @@index([branchId])
}

// One account moved by a journal, on the debit side or the credit side (never both).
// The database enforces: exactly one side above zero, and debits equal credits per journal.
model JournalLine {
  id              String           @id @default(uuid())
  journalId       String
  lineNumber      Int
  ledgerAccountId String
  debitKobo       BigInt           @default(0)
  creditKobo      BigInt           @default(0)
  memo            String?
  partyType       LedgerPartyType?
  partyId         String?

  journal       JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@unique([journalId, lineNumber])
  @@index([ledgerAccountId, journalId])
  @@index([partyType, partyId])
}
